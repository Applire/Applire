  "metadata": {
    "created_at": "2026-10-12T07:35:17.629044Z",
    "created_via": "cv_paste",
    "last_updated": "2026-10-12T07:39:44.762673Z",
    "denied_concepts": [
      {
        "date": "2026-10-12",
        "source": "interview",
        "concept": "US-GAAP",
        "statement": "Bei der Einführung von LucaNet in unserer kleinen Gruppe (GmbH plus Vertriebsgesellschaft Schweiz) habe ich das Teilprojekt Intercompany-Abstimmung und Kapitalkonsolidierung verantwortet und erstelle seit 2023 die konsolidierten Quartalszahlen darin mit. Verantwortlich zeichnet unsere Leiterin Rechnungswesen, ich bin die operative Nummer zwei dafür. Zum Jahresabschluss: Ich betreue bei Schwarzwald Präzision seit 2019 den HGB-Monats- und Jahresabschluss inklusive der Wirtschaftsprüfer. Zu IFRS habe ich 2024 den Zertifikatskurs der Controller Akademie absolviert und im letzten Abschluss zwei Themen (Leasing nach IFRS 16 und Umsatzrealisierung für einen Servicevertrag) parallel nach IFRS bewertet, als nicht testierte Übungsrechnung für die Gruppe; IFRS-Abschlüsse in Hauptverantwortung habe ich nicht erstellt. Mit US-GAAP habe ich keine Erfahrung, weder im Abschluss noch im Reporting. Das ist eine ehrliche Lücke.",
        "probe_asked": false,
        "denial_level": "direct"
      },
      {
        "date": "2026-10-12",
        "source": "interview",
        "concept": "Make-or-buy-Entscheidungen",
        "statement": "Bei Brauner & Söhne Maschinenbau habe ich von 2016 bis 2019 Investitionsrechnungen für Maschinenbeschaffungen erstellt. Konkrete Zahlen oder Ergebnisse dazu kann ich hier nicht nennen. Zu Make-or-buy-Entscheidungen habe ich keine Erfahrung, dazu kann ich nichts Belegbares sagen.",
        "probe_asked": false,
        "denial_level": "direct"
      },
      {
        "date": "2026-10-12",
        "source": "interview",
        "concept": "Anlagenbau",
        "statement": "Bei Schwarzwald Präzision mache ich das Werkscontrolling für zwei Produktionsstandorte mit Herstellkosten, Deckungsbeiträgen und Bestandsbewertung. Für unseren Sondermaschinenbereich habe ich 2022 die Bewertung langfristiger Aufträge nach Fertigstellungsgrad eingeführt und bewerte seitdem monatlich sechs Großprojekte. Einen Anlagenbau im engeren Sinn habe ich nicht betreut, mein Bezug ist dieser Sondermaschinenbereich.",
        "probe_asked": false,
        "denial_level": "direct"
      },
      {
        "date": "2026-10-12",
        "source": "interview",
        "concept": "Disziplinarische Führung",
        "statement": "Fachlich führe ich seit zwei Jahren die beiden Werkstudierenden und seit letztem Jahr zusätzlich eine Junior-Controllerin in der Einarbeitung, mit Abschlussthemen und Review ihrer Reports. Disziplinarische Führung hatte ich noch nicht. Die Entwicklungsperspektive in der Ausschreibung ist für mich der Hauptgrund zu wechseln.",
        "probe_asked": false,
        "denial_level": "direct"
      }
    ],
