    "denied_concepts": [
      {
        "date": "2026-10-12",
        "source": "interview",
        "concept": "US-GAAP",
        "statement": "Zu IFRS: Ich habe 2024 den IFRS-Zertifikatskurs der Controller Akademie absolviert und im letzten Abschluss zwei Themen parallel nach IFRS bewertet, nämlich Leasing nach IFRS 16 und die Umsatzrealisierung für einen Servicevertrag. Das war eine Übungsrechnung für die Gruppe und nicht testiert. Hauptverantwortlich IFRS-Abschlüsse erstellt habe ich nicht. Zu US-GAAP: Nein, mit US-GAAP habe ich keine Erfahrung, weder im Abschluss noch im Reporting. Das ist eine ehrliche Lücke.",
        "probe_asked": false,
        "denial_level": "direct"
      },
      {
        "date": "2026-10-12",
        "source": "interview",
        "concept": "Make-or-buy-Entscheidungen",
        "statement": "Bei Brauner & Söhne Maschinenbau habe ich von 2016 bis 2019 als Junior Controllerin Investitionsrechnungen für Maschinenbeschaffungen erstellt. Zu Investitionsvolumen oder Ergebnissen habe ich keine Zahlen parat. Make-or-buy-Entscheidungen habe ich nicht selbst begleitet, dazu habe ich keine Erfahrung.",
        "probe_asked": false,
        "denial_level": "direct"
      },
      {
        "date": "2026-10-12",
        "source": "interview",
        "concept": "Disziplinarische Führung",
        "statement": "Bei Schwarzwald Präzision führe ich seit zwei Jahren die beiden Werkstudierenden fachlich und seit letztem Jahr zusätzlich eine Junior-Controllerin in der Einarbeitung. Ich betreue ihre Abschlussthemen und reviewe ihre Reports. Disziplinarische Führung hatte ich noch nicht. Die Entwicklungsperspektive in der Ausschreibung ist für mich der Hauptgrund zu wechseln.",
        "probe_asked": false,
        "denial_level": "direct"
      }
    ],
