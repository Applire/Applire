# Real-auth CI lane — safe to commit, contains no real secrets.
# Used by docker-compose.ci-auth.yml (ADR-091 D-1: unit and most E2E lanes run
# on the NoAuth harness; ONE lane runs with login on, as a self-hoster would).
#
# Deliberately NOT here:
# * AUTH_HARNESS — login is on; the instance is claimed with the setup code
#   printed in the backend log (or `python -m applire.admin create-admin`).
# * APPLIRE_BASE_URL — left at the shipped default so the origin check compares
#   the browser's Origin with the Host nginx forwards ($http_host, incl. the
#   non-80 port). That is the configuration every operator starts with.
# * POSTGRES_DB — the production default name (`applire`), like an install.

# LLM — mock provider: instant responses, no API key, no rate limits
LLM_PROVIDER=mock

# Placeholder keys (required by config validation, not used by mock provider)
MISTRAL_API_KEY=mock-not-used
OPENROUTER_API_KEY=mock-not-used
OPENAI_API_KEY=mock-not-used

# Auth — built-in accounts, as shipped (ADR-091). COOKIE_SECURE stays off: the
# lane serves plain http (S-15 default).
AUTH_PROVIDER=local
COOKIE_SECURE=false
