# CI/CD environment — safe to commit, contains no real secrets.
# Used by docker-compose.ci.yml for GitHub Actions and local CI runs.

# Database — the `_ci` suffix is part of the NoAuth test-harness fence
# (ADR-091 cl. 3 (c)): the harness serves only SQLite in-memory or a Postgres
# database whose name ends in _ci/_test and held no profile at boot.
# POSTGRES_DB is the variable that matters: docker-compose.yml builds every
# service's DATABASE_URL from ${POSTGRES_DB:-applire} in `environment:`, which
# beats env_file. The workflows `cp .env.ci .env`, so compose interpolates it.
POSTGRES_DB=applire_ci
DATABASE_URL=postgresql+asyncpg://applire:applire@postgres:5432/applire_ci

# LLM — mock provider: instant responses, no API key, no rate limits
LLM_PROVIDER=mock

# Placeholder keys (required by config validation, not used by mock provider)
MISTRAL_API_KEY=mock-not-used
OPENROUTER_API_KEY=mock-not-used
OPENAI_API_KEY=mock-not-used

# Ollama (not started in CI)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# Auth — the CI lanes run on the fenced NoAuth test harness: every request is
# the stub admin while no account holds a credential (ADR-091 cl. 3, D-1).
# NEVER copy these two lines into a real install's .env: the backend refuses to
# start with them unless the database is a throwaway test database.
# The real-auth lane uses .env.ci-auth (no harness).
AUTH_PROVIDER=local
AUTH_HARNESS=true

# CORS
APPLIRE_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
