# Applire — Environment Configuration
# Copy to .env and fill in your values:  cp .env.example .env
#
# GENERATED FILE — do not edit by hand.
# Every variable below is declared once in backend/applire/settings_registry.py
# (ADR-087); this file is rendered from it by scripts/generate_env_example.py and
# a unit test fails when the two drift. To change a comment or a default, edit the
# registry entry and re-run the generator.
#
# Lines that are commented out are OPTIONAL: the value shown is what the code uses
# when you leave them alone. Deleting an uncommented line falls back to the same
# default — the examples here ARE the code defaults, except where a line says
# otherwise.

# ==========================================================================
# Database
# ==========================================================================

# PostgreSQL connection string. Under docker compose the compose file builds this from
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB below, so change those rather than
# this line.
DATABASE_URL=postgresql+asyncpg://applire:applire@postgres:5432/applire

# Database credentials. The defaults are the values every install has used so far, so
# changing nothing changes nothing. On a host where the database port could ever be
# reachable, set all three — and remember that Postgres reads them only when the data
# volume is FIRST created; an existing volume keeps its original credentials
# (docs/SELF-HOSTING.md, Secrets).
# since: 0.42.0
#POSTGRES_USER=applire

# Database password — see POSTGRES_USER above.
# since: 0.42.0
#POSTGRES_PASSWORD=applire

# Database name — see POSTGRES_USER above.
# since: 0.42.0
#POSTGRES_DB=applire

# ==========================================================================
# LLM provider — bring your own key
# ==========================================================================

# Bring your own key: pick any provider below and supply its key.
# Your data goes only to the provider you choose. No provider is privileged.
#
# The value below is an EXAMPLE, not a recommendation. It decides where your CVs
# and answers are sent, so choose it deliberately at install time — with whoever
# the data belongs to — rather than inheriting it:
#   ollama                        stays on your machine, no key, no cloud
#   mistral, requesty             stay in the EU (Requesty also routes to
#                                 Claude/GPT/Gemini via their EU deployments)
#   openrouter, anthropic, openai US-hosted
# Choosing a model? See docs/llm-models.md (capability floor + recommendations).
# choose one: mistral | requesty | openrouter | anthropic | openai | ollama
LLM_PROVIDER=mistral

# Mistral AI — EU-hosted, strong German proficiency.
MISTRAL_API_KEY=your-mistral-api-key-here

# code default — pick per docs/llm-models.md. Larger Mistral models
# (mistral-medium-latest, mistral-large-latest) follow the reconcile and review prompts
# more reliably; this line shows what the code uses when you delete it.
MISTRAL_MODEL=mistral-small-latest

# OpenRouter — multi-model gateway (set LLM_PROVIDER=openrouter).
# Bypasses per-provider rate limits. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# code default — pick per docs/llm-models.md.
OPENROUTER_MODEL=mistralai/mistral-large-latest

# leave empty to use https://openrouter.ai/api/v1
#OPENROUTER_BASE_URL=

# Emit reasoning:{enabled:false} on every OpenRouter call (cross-vendor:
# Gemini/Qwen/DeepSeek). A per-call override still wins. Some models MANDATE reasoning
# and reject this — use OPENROUTER_REASONING_EFFORT there.
#OPENROUTER_DISABLE_THINKING=false

# low | medium | high — bound reasoning on models that keep it ON. Reasoning tokens
# share the max_tokens budget, so an over-thinking model can burn the budget and
# truncate the visible answer. Empty = let the model decide.
# since: 0.37.0
#OPENROUTER_REASONING_EFFORT=

# Requesty — EU-hosted gateway (Frankfurt, zero-retention), set LLM_PROVIDER=requesty.
# Also an EU-resident path to Claude/GPT/Gemini (Bedrock/Azure/Vertex EU deployments).
# Get a key at https://app.requesty.ai
# since: 0.37.0
REQUESTY_API_KEY=your-requesty-api-key-here

# For FULL residency pick an EU-region model, e.g.
# bedrock/claude-sonnet-4-5-v2@eu-central-1
# since: 0.37.0
REQUESTY_MODEL=mistralai/mistral-large-latest

# empty = https://router.eu.requesty.ai/v1 (EU); use https://router.requesty.ai/v1 for
# the global router
# since: 0.37.0
#REQUESTY_BASE_URL=

# Emit reasoning_effort:"none"; a per-call override still wins.
# since: 0.38.0
#REQUESTY_DISABLE_THINKING=false

# low | medium | high | max — bound reasoning when it stays on.
# since: 0.38.0
#REQUESTY_REASONING_EFFORT=

# Anthropic (Claude) — native Messages API, set LLM_PROVIDER=anthropic.
# BYO-API-key ONLY: a Claude Pro/Max/Team SUBSCRIPTION cannot be used —
# Anthropic prohibits subscription auth in third-party apps. Get a key at
# https://console.anthropic.com
# US-hosted; for Claude with EU residency use LLM_PROVIDER=requesty instead.
# since: 0.37.0
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model ids move fast — take a current one from
# https://docs.anthropic.com/en/docs/about-claude/models rather than an example pinned
# in this file.
# since: 0.37.0
#ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI or any OpenAI-compatible server (set LLM_PROVIDER=openai).
OPENAI_API_KEY=your-openai-api-key-here

# code default.
#OPENAI_MODEL=gpt-4o

# For LM Studio: set this and leave OPENAI_API_KEY as any non-empty string. Empty = the
# OpenAI default endpoint.
# code default: (empty)
#OPENAI_BASE_URL=http://host.docker.internal:1234/v1

# Ollama — fully offline (set LLM_PROVIDER=ollama).
# Start with: docker compose --profile ollama up
# The server starts EMPTY: pull a model once
# (docker compose exec ollama ollama pull llama3.2) or set OLLAMA_MODEL to
# one you pulled; CPU-only inference is slow — raise LLM_TIMEOUT (e.g. 600).
OLLAMA_BASE_URL=http://ollama:11434

# The model you pulled into the Ollama container.
OLLAMA_MODEL=llama3.2

# ==========================================================================
# LLM behaviour — timeouts, caps, diagnostics
# ==========================================================================

# Seconds. Raise for thinking/reasoning models (Qwen3, o3, DeepSeek-R1 etc.) — code
# default 120. Keep it BELOW the reverse proxy's read timeout (300 s, baked into the
# applire-nginx image) or the proxy cuts the connection first and the operator sees a
# 504 instead of the real error.
# code default: 120
LLM_TIMEOUT=180

# off | auto. 'auto' hands the model the reconciler's 15-op union as a JSON schema
# instead of only describing it in prose, on the one call whose output is a typed union.
# Costs ~2,500 extra input tokens per interview turn; helps models that drop a required
# field or mangle an op name. An endpoint that does not support schemas rejects it once
# and falls back for the rest of the process.
# since: 0.42.0
#LLM_STRUCTURED_OUTPUT=off

# Operator-declared hard output cap for the chosen model, in tokens. 0 = unset (no known
# cap). When set, every requested max_tokens is clamped to it, so a capped model is
# never asked for more than it can emit (ADR-047 §2). Optional: segmentation already
# handles capped models without metadata.
# since: 0.37.0
#LLM_MAX_OUTPUT_TOKENS=0

# Developer-only: log every LLM call's full input/output to
# <LLM_DEBUG_LOG_DIR>/<date>.jsonl (one JSON line per call: stage, model,
# system, prompt, params, response, latency).
# RECORDS CV PII — keep OFF in production. While it is on, the backend logs
# a WARNING at every startup and GET /health reports debug_log_on: true.
# There is deliberately no size or age cap: a cap on a diagnostic tool
# truncates evidence silently. Turn it off, and delete the files.
# code default: false
# since: 0.37.0
#LLM_DEBUG_LOG=true

# Where those JSONL files land, relative to the backend's workdir.
# since: 0.37.0
#LLM_DEBUG_LOG_DIR=logs/llm

# Embeddings for the job-match score. 'noop' (the default) skips them and the match
# score falls back to its LLM half.
#EMBEDDING_PROVIDER=noop

# Empty = the embedding provider's own default.
#EMBEDDING_MODEL=

# ==========================================================================
# Operations — logging, topology and instance behaviour
# ==========================================================================

# DEBUG | INFO | WARNING | ERROR — applied to every applire.* logger. DEBUG is loud; it
# does not log prompts (that is LLM_DEBUG_LOG).
#LOG_LEVEL=INFO

# Seconds after which an unattended in-app notice pop-up hides itself.
# 0 = never; the reader closes it. Raise it for a shared screen or for anyone who needs
# longer to read — it applies to the whole instance, not per user, and is served
# read-only on GET /api/settings.
# since: 0.42.0
#NOTICE_AUTO_DISMISS_SECONDS=30

# Which compose topology this instance runs — set by the compose files, never by hand.
# 'production' (docker-compose.yml alone — nginx on :80 is the only published port) or
# 'dev' (docker-compose.override.yml is also applied — builds from source, hot-reload
# backend, and 3000/8001/5433 published).
# The override file sets it; leaving it unset is what makes 'production' true. A 'dev'
# value logs a WARNING at startup and appears at GET /health — running a clone with a
# plain `docker compose up` silently applies the override, which is a debugging
# topology.
# since: 0.42.0
#APPLIRE_TOPOLOGY=production

# ==========================================================================
# Retention — GDPR TTLs enforced by the retention worker (ADR-005)
# ==========================================================================

# GDPR retention TTLs, in DAYS, enforced by the retention worker once a
# day (ADR-005). Deletion is irreversible — read docs/SELF-HOSTING.md
# before changing one.
# Generated CVs and cover letters, counted from the application's last
# activity.
#GENERATED_DOCUMENTS_TTL_DAYS=90

# Grace window after an application is cancelled. Its documents (including submitted
# pins) are purged after this regardless of GENERATED_DOCUMENTS_TTL_DAYS. 0 disables the
# short clock.
# since: 0.38.0
#CANCELLED_APPLICATION_TTL_DAYS=7

# Interview transcripts, counted from the last message.
#INTERVIEW_SESSION_TTL_DAYS=30

# Uploaded CV files. The extracted content lives on in the profile; the file itself is
# deleted.
#UPLOAD_TTL_DAYS=7

# The whole profile, after this long without activity. Two years by default. This is the
# vault — the candidate's career record.
#PROFILE_INACTIVITY_TTL_DAYS=730

# The orphan-file scan skips files younger than this: an upload is written before its
# database row is committed, so a young unreferenced file may be an upload in flight
# rather than an orphan.
# since: 0.38.0
#ORPHAN_FILE_GRACE_HOURS=1

# ==========================================================================
# Storage and uploads
# ==========================================================================

# Where uploaded CVs and profile photos are written inside the backend container. The
# compose file mounts the applire_uploads volume here — if you change this, change the
# volume mount too, or every uploaded file is lost on the next `docker compose pull`.
#UPLOAD_DIR=./data/uploads

# 'local' is the only Community backend.
#STORAGE_BACKEND=local

# How a scanned or image-only PDF is read. 'mistral_vision' needs a Mistral key even
# when LLM_PROVIDER is something else.
#OCR_BACKEND=mistral_vision

# Absolute path to the static-asset directory (CV template thumbnails). Empty = the
# package-relative default, which is what the image ships. Set only if you serve those
# assets from elsewhere.
# since: 0.36.0
#STATIC_DIR=<backend>/data/static

# ==========================================================================
# Network and access
# ==========================================================================

# 'none' disables authentication, which is the only Community option and
# is appropriate for a SINGLE-PERSON self-hosted instance. Anyone who can
# reach the URL can read and change the vault — do not put an
# AUTH_PROVIDER=none instance on a shared network without your own
# authenticating proxy in front of it (docs/SELF-HOSTING.md).
# Zitadel OIDC is a Cloud Edition feature.
AUTH_PROVIDER=none

# Comma-separated list of allowed origins. '*' is safe for a single-user self-hosted
# install with AUTH_PROVIDER=none; lock it down otherwise, e.g.
# CORS_ORIGINS=https://app.example.com
#CORS_ORIGINS=*

# MCP / agent channel — the base URL used to build html_url / pdf_url in
# tool responses (generate_cv, get_cv_status, generate_cover_letter, ...).
# The default is correct only for a local, unproxied dev setup. Set this to
# the externally reachable scheme://host:port of your reverse proxy for any
# other deployment, or agent-fetched artifact links silently point at
# localhost:8001 instead of your real host.
#APPLIRE_BASE_URL=http://localhost:8001

# Transport for `python -m applire.mcp`. 'stdio' is the supported Community transport
# (ADR-010).
#MCP_TRANSPORT=stdio

# Frontend API URL.
# docker compose: leave this EMPTY — the nginx service at :80 routes
# /api/* to the backend and the browser uses relative paths.
# standalone (npm run dev outside Docker): set it to http://localhost:8001
# so the frontend talks to the backend directly.
# code default: (empty)
#NEXT_PUBLIC_API_URL=http://localhost:8001

# ==========================================================================
# Advanced tuning — read by constants.py and config.py.
# Declared so nothing is invisible, not because you should change it.
# Leave these alone unless a real run gives you a reason.
# ==========================================================================

# Interview question-count CAP for a targeted (MODE A) interview.
# CHANGED IN 0.41.0 (ADR-080): this is a CAP, not the budget. A session's
# budget is now derived from its own gap plan —
# INTERVIEW_MAX_QUESTIONS_PER_GAP x (gaps to work through) + 2 — and this
# value is applied afterwards as an upper bound. Previously it WAS the
# budget. Setting it BELOW the derived budget truncates interviews on
# gap-rich jobs: the candidate is told the question limit was reached, with
# real gaps left unasked. Leave unset unless you need to bound cost.
# since: 0.38.0
# meaning changed in: 0.41.0
#INTERVIEW_MAX_QUESTIONS_TARGETED=30

# The same cap for a guided (MODE B) interview. Same 0.41.0 change of meaning as
# INTERVIEW_MAX_QUESTIONS_TARGETED above.
# since: 0.38.0
# meaning changed in: 0.41.0
#INTERVIEW_MAX_QUESTIONS_GUIDED=30

# Questions a single gap may consume (its question plus a follow-up or denial probe).
# Also the multiplier in the ADR-080 budget derivation, so raising it lengthens
# interviews twice over.
#INTERVIEW_MAX_QUESTIONS_PER_GAP=2

# Retries for the interview question's output-language review (ADR-038). 0 disables it
# and leaves the language directive alone to do the job.
# since: 0.36.0
#INTERVIEW_QUESTION_LANG_REVIEW_MAX_RETRIES=1

# LLM review layer — max generator retries per reviewed step (ADR-021). 0 disables the
# review layer entirely, which also disables both terminal reviews. Raising it
# multiplies provider calls.
#LLM_REVIEW_MAX_RETRIES=2

# Retries in the CV's TERMINAL review round, over the composed document (ADR-076 cl. 3).
# Deliberately tighter than LLM_REVIEW_MAX_RETRIES.
# since: 0.39.0
#CV_TERMINAL_REVIEW_MAX_RETRIES=1

# How often a post-verdict change may re-enter the CV's terminal review before the
# document ships with the gap logged.
# since: 0.39.0
#CV_TERMINAL_REENTRY_MAX=1

# The cover letter's twin of CV_TERMINAL_REVIEW_MAX_RETRIES.
# since: 0.39.0
#LETTER_TERMINAL_REVIEW_MAX_RETRIES=1

# The cover letter's twin of CV_TERMINAL_REENTRY_MAX.
# since: 0.39.0
#LETTER_TERMINAL_REENTRY_MAX=1

# Retries for the generated document's output-language review (ADR-038). 2, not 1: the
# language pass is the last writer in the pipeline and carries the coverage gate, so its
# own output has to be reviewable.
# since: 0.37.0
#CV_LANGUAGE_REVIEW_MAX_RETRIES=2

# The outcome critic's cross-document coherence pass (ADR-060). Default ON; set false to
# save one provider call per application.
# since: 0.39.0
#CRITIC_ENABLED=true

# Retry budget for the critic's single judgement call on malformed output. The critic
# never asks the writer to try again.
# since: 0.39.0
#CRITIC_MAX_ROUNDS=1

# How many skills the tailored CV may present. JD-required skills that exist in the
# profile are kept even past the cap; no-relevance tags are dropped first.
# since: 0.38.0
#CV_MAX_SKILLS=24

# Pre-merge profile snapshots kept per profile (the undo history for an import). The
# most recent N survive.
# since: 0.37.0
#SNAPSHOT_MAX_PER_PROFILE=10

# Reconciliation delta STRICTLY ABOVE this makes a merge finding critical rather than a
# dismissible review.
# since: 0.37.0
#MERGE_DATALOSS_CRITICAL_THRESHOLD=3

# Merge confidence BELOW this asks the candidate to review.
# since: 0.37.0
#MERGE_CONFIDENCE_REVIEW_THRESHOLD=0.75

# Truthfulness Oracle (ADR-052). A raw prose block goes to the LLM segmentation fallback
# only when it is longer than this AND deterministic sentence splitting found no
# boundaries.
# since: 0.38.0
#ORACLE_PROSE_FALLBACK_CHARS=600

# Output cap for one Oracle segmentation call.
# since: 0.38.0
#ORACLE_SEGMENT_MAX_TOKENS=800

# Hard cap on segmentation calls per audited document. Exhausted, the block is treated
# as one claim.
# since: 0.38.0
#ORACLE_MAX_SEGMENT_CALLS=5

# Output cap for one narrow entailment verdict.
# since: 0.38.0
#ORACLE_ENTAILMENT_MAX_TOKENS=200

# Hard cap on entailment calls per audited document; claims past it fall back to the
# deterministic verdict.
# since: 0.38.0
#ORACLE_MAX_ENTAILMENT_CALLS=10

# Per-item token budget for a batched equivalence judgement (ADR-068).
# since: 0.39.0
#ORACLE_JUDGEMENT_MAX_TOKENS=120

# Hard cap on judgement batch calls per document; candidates past it degrade to
# judgement_unavailable rather than to a guess.
# since: 0.39.0
#ORACLE_MAX_JUDGEMENT_CALLS=5

# Per-item token budget for the batched pre-grading triage call.
# since: 0.39.0
#ORACLE_TRIAGE_MAX_TOKENS=160

# Hard cap on triage batch calls. Triage gates every letter claim, so exhausting this
# audits the remaining sentences as candidate claims.
# since: 0.39.0
#ORACLE_MAX_TRIAGE_CALLS=3

# Weights for GET /api/jobs/match. Must sum to 1.0 with MATCHING_SCORE_LLM_WEIGHT.
#MATCHING_SCORE_EMBEDDING_WEIGHT=0.4

# See MATCHING_SCORE_EMBEDDING_WEIGHT.
#MATCHING_SCORE_LLM_WEIGHT=0.6

# Free space on the uploads filesystem, in percent, below which the ops health endpoint
# reports a warning.
# since: 0.42.0
#OPS_DISK_FREE_WARN_PERCENT=10

# How often the retention worker is expected to run. The ops layer warns after more than
# two of these without a run.
# since: 0.42.0
#OPS_RETENTION_INTERVAL_SECONDS=86400

# A retention deletion counter is flagged when it exceeds this multiple of the median of
# previous runs.
# since: 0.42.0
#OPS_RETENTION_ANOMALY_FACTOR=10

# How many previous retention runs must exist before the anomaly check runs at all.
# since: 0.42.0
#OPS_RETENTION_ANOMALY_MIN_RUNS=3

# How many retention-run records to keep. 0 = keep all.
# since: 0.42.0
#OPS_RETENTION_RUNS_KEEP=90

# Days without a successful backup before the ops health endpoint warns. Requires
# scripts/backup.sh to have run.
# since: 0.42.0
#OPS_BACKUP_WARN_DAYS=30

# Rolling window for the ops error-rate counter.
# since: 0.42.0
#OPS_ERROR_WINDOW_MINUTES=60

# Which checks the instance runs against your LLM provider: 'both' (default),
# 'reachability' (a tiny test call, about 96 a day), 'credit' (reads your balance where
# the provider offers one - costs nothing), or 'off'. With 'off' the instance cannot
# tell you that your provider credit ran out. Ollama and other local endpoints have no
# balance to read; the credit check reports 'not applicable' for them.
# since: 0.42.0
#OPS_PROVIDER_PROBE=both

# Minimum minutes between two provider probes.
# since: 0.42.0
#OPS_PROVIDER_PROBE_INTERVAL_MINUTES=15

# Remaining provider credit below which the ops health endpoint reports 'low'. Only
# providers that publish a balance (OpenRouter, Requesty) can report anything but
# 'unknown'.
# since: 0.42.0
#OPS_PROVIDER_CREDIT_LOW_THRESHOLD=1.0

# How often the backend recomputes its own health picture in the background, so the log
# warning and /health's ops summary do not wait for someone to open the dashboard.
# since: 0.42.0
#OPS_REFRESH_SECONDS=60

# Whether every LLM call records its token counts. Numbers and ids only - no prompt or
# answer text is ever stored.
# since: 0.42.0
#LLM_USAGE_TRACKING=on

# How many days token-usage records are kept. 0 = keep forever.
# since: 0.42.0
#LLM_USAGE_RETENTION_DAYS=365
