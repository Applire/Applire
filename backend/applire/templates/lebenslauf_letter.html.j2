<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8"/>
  <title>{{ labels.document_title }} – {{ letter.header.name }}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --primary: {{ color.primary }};
      --primary-tint: {{ color.primary_tint }};
      --surface: {{ color.surface }};
      --surface-text: {{ color.surface_text }};
    }
    body { font-family: Georgia, "Times New Roman", serif; font-size: 10.5pt; line-height: 1.6; color: #1a1a1a; background: #fff; }
    .page { width: 210mm; min-height: 297mm; margin: 0 auto; padding: 20mm 22mm 20mm 25mm; }
    /* Header = the CV twin's header (lebenslauf.html.j2, same template id): mixed-case
       serif name, flex contact line, 2px ink rule. Accent colour appears nowhere
       in the CV header, so it does not here either. */
    .header { border-bottom: 2px solid #1a1a1a; padding-top: 6mm; padding-bottom: 8pt; margin-bottom: 10mm; line-height: 1.45; }
    .header-name { font-size: 20pt; font-weight: bold; letter-spacing: 0.03em; margin-bottom: 4pt; }
    .header-contact { display: flex; flex-wrap: wrap; gap: 0 18pt; font-size: 9.5pt; color: #333; font-family: "Times New Roman", Times, serif; }
    .recipient { margin-bottom: 8mm; font-size: 10pt; line-height: 1.5; }
    .date { text-align: right; margin-bottom: 6mm; font-size: 10pt; color: #555; }
    .subject { font-weight: bold; font-size: 11pt; margin-bottom: 6mm; }
    .body p { margin-bottom: 5mm; font-size: 10.5pt; text-align: justify; }
    /* #429 (run 15): keep-together so the break can never fall inside the
       block, and 4mm less signature air — a budget-length body (266 words)
       overflowed 297mm by ~3mm, orphaning the bare sender name on page 2.
       #547: break-inside:avoid pushes the WHOLE block to page 2 once it no
       longer fits the remainder of page 1 — the atomic-block fix above did
       not stop the block itself from being bounced whole, orphaning it
       alone with the freed space still visible on page 1. 4mm less air
       (again) shrinks the atomic unit so it fits the remainder more often;
       this is a probability reduction, not a proof — CSS pagination cannot
       guarantee fit without content-aware sizing. */
    .signature { break-inside: avoid; page-break-inside: avoid; break-before: avoid; page-break-before: avoid; margin-top: 4mm; font-size: 10.5pt; }
    /* 786:L41 keep-with-signature: the last paragraph and the closing move as one unit, so a page break never leaves the closing alone. */
    .body p:last-child { break-after: avoid; page-break-after: avoid; }
    .signature .closing { margin-bottom: 6mm; }
    .signature-image { display: block; height: 14mm; width: auto; max-width: 60mm; margin: 0 0 1mm; }
    .signature.has-signature .closing { margin-bottom: 2mm; }
    /* #621 — the visual margin now lives in @page (Chromium's paged-media
       engine re-applies it on every page); .page's own padding/size, which
       used to BE the margin on the print path, is neutralised in print so it
       doesn't double up with @page. Kept for the on-screen HTML preview
       above (width/min-height/padding), which never goes through @page. */
    @page {
      size: A4;
      margin: 20mm 22mm 20mm 25mm;
    }
    /* #621 follow-up (main session, measured): page 1 keeps a small print-safe top
       inset so a budget-length letter keeps its page-1 capacity (LETTER_DE_BUDGET
       stays 1 page; see tests/ats/test_page_geometry.py::test_letter_page1_capacity_holds_621);
       continuation pages (rare) get the full 20mm. Originally sized for the coloured
       header band that bled to the paper edge; the header is now the CV's white
       header (no band). The name must not sit 5mm from the paper edge, so the visual
       12mm top inset is split: 6mm here (the source pin
       test_lebenslauf_letter_keeps_a_page1_top_inset_621 caps this at 6mm) + 6mm
       padding-top on .header. Page-1 capacity is the same as a 12mm inset. */
    @page :first {
      margin-top: 6mm;
    }
    @media print {
      body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .page { padding: 0; width: auto; min-height: auto; margin: 0; }
    }
  </style>
</head>
<body>
<div class="page">
  <div class="header">
    <div class="header-name">{{ letter.header.name }}</div>
    <div class="header-contact">
      {% if letter.header.address %}<span>{{ letter.header.address }}</span>{% endif %}
      {% if letter.header.phone %}<span>{{ letter.header.phone }}</span>{% endif %}
      {% if letter.header.email %}<span>{{ letter.header.email }}</span>{% endif %}
    </div>
  </div>

  <div class="recipient">
    {% if letter.recipient.name %}{{ letter.recipient.name }}<br>{% endif %}
    {% if letter.recipient.title %}{{ letter.recipient.title }}<br>{% endif %}
    {% if letter.recipient.company %}{{ letter.recipient.company }}<br>{% endif %}
    {% if letter.recipient.address %}{{ letter.recipient.address }}{% endif %}
  </div>

  <div class="date">{{ letter.recipient.date }}</div>

  <div class="subject">{{ subject }}{% if letter.recipient.company %} {{ labels.subject_at }} {{ letter.recipient.company }}{% endif %}</div>

  <div class="body">
    {% for para in letter.body.paragraphs %}
    <p>{{ para }}</p>
    {% endfor %}
  </div>

  <div class="signature{% if signature_image %} has-signature{% endif %}">
    <div class="closing">{{ letter.signature.closing }}{{ labels.closing_punctuation }}</div>
    {% if signature_image %}<img class="signature-image" src="{{ signature_image }}" alt="">{% endif %}
    <div>{{ letter.signature.name }}</div>
  </div>
</div>
</body>
</html>
