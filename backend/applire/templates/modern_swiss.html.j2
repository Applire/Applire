<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ labels.document_title }} – {{ cv.contact.name }}</title>
  <style>
    /* -----------------------------------------------------------------------
       Modern Swiss CV — A4, print-optimised
       Single-column, clean sans-serif, accent strip on the left
       Optional circular avatar (show_photo flag). EN/DE bilingual section headers.
       ----------------------------------------------------------------------- */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cv-accent: {{ color.accent }};
      --cv-accent-tint: {{ color.tint }};
      --text: #1c1c1c;
      --muted: #5a5a5a;
      --rule: #d0d5dd;
    }

    body {
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-size: 10.5pt;
      line-height: 1.5;
      color: var(--text);
      background: #fff;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      padding: 18mm 20mm 18mm 20mm;
    }

    /* ---- Header ---- */
    .header {
      border-left: 4pt solid var(--cv-accent);
      padding-left: 10pt;
      margin-bottom: 18pt;
    }

    .header-name h1 {
      font-size: 22pt;
      font-weight: 700;
      letter-spacing: -0.01em;
      color: var(--text);
    }

    .header-contact {
      text-align: right;
      font-size: 9pt;
      color: var(--muted);
      line-height: 1.7;
    }

    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 14pt;
    }
    .header-text { flex: 1; }
    .header-avatar {
      flex-shrink: 0;
      width: 36mm;
      height: 36mm;
      border-radius: 50%;
      overflow: hidden;
    }
    .header-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
    }

    /* ---- Section ---- */
    .section {
      margin-bottom: 16pt;
    }

    .section-header {
      display: flex;
      align-items: baseline;
      gap: 8pt;
      margin-bottom: 8pt;
      /* #357 — a section heading never orphans at the foot of a page. */
      break-after: avoid;
      page-break-after: avoid;
    }

    .section-title-en {
      font-size: 11pt;
      font-weight: 700;
      color: var(--cv-accent);
      text-transform: uppercase;
      letter-spacing: 0.07em;
    }

    .section-title-de {
      font-size: 9pt;
      color: var(--muted);
      font-style: italic;
    }

    .section-rule {
      flex: 1;
      height: 1px;
      background: var(--rule);
      margin-left: 6pt;
    }

    /* ---- Entry (work / education) ---- */
    .entry {
      margin-bottom: 10pt;
      padding-left: 2pt;
      /* #357/#622 — a SHORT entry (<=3 bullets, class .entry-atomic below)
         stays one unit. A LONG entry (>3 bullets) may now break. */
    }

    /* #622 — break policy. SHORT entries (<=3 bullets, and every education/
       certification entry, which never carries bullets) stay atomic, same as
       #357. LONG entries (>3 bullets) may break, but the head (title/company/
       dates) + first 2 bullets is one keep-together group (.entry-lead), the
       last 2 bullets are another (.entry-tail), and every remaining bullet is
       itself atomic (.section li) — never mid-sentence. List sections
       (certifications/education/...) follow the same shape at the item
       level via .section-atomic/.section-lead/.section-tail below, so a
       heading or a single stranded item never sits alone at a page foot. */
    .entry-atomic {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .entry-lead,
    .entry-tail {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .section li {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .entry-lead ~ .entry-bullets,
    .entry-tail .entry-bullets {
      margin-top: 0;
    }
    .project-item {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .section-atomic {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .section-lead,
    .section-tail {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .entry-meta {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 1pt;
    }

    .entry-title {
      font-weight: 700;
      font-size: 10.5pt;
    }

    .entry-dates {
      font-size: 9.5pt;
      color: var(--muted);
      white-space: nowrap;
    }

    .entry-subtitle {
      font-size: 10pt;
      color: var(--muted);
      margin-bottom: 3pt;
    }

    /* Quantified role facts (#328) — deterministic furniture, never prose */
    .entry-facts {
      font-size: 9pt;
      color: var(--muted);
      margin-bottom: 3pt;
    }

    .entry-bullets {
      padding-left: 12pt;
      list-style-type: disc;
      margin-top: 3pt;
    }

    .entry-bullets li {
      margin-bottom: 1.5pt;
      font-size: 10pt;
    }

    /* ---- Projects nested under a position ---- */
    .entry-projects { margin-top: 4pt; }
    .entry-projects-title {
      font-size: 8.5pt;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--cv-accent);
      margin-bottom: 2pt;
    }
    .project-item { margin-bottom: 3pt; }
    .project-name { font-weight: 600; font-size: 10pt; }

    /* ---- Summary ---- */
    .summary-text {
      font-size: 10.5pt;
      line-height: 1.55;
      color: var(--text);
    }

    /* ---- Skills ---- */
    .skills-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 4pt 14pt;
      list-style: none;
    }

    .skills-grid li {
      font-size: 10pt;
      padding: 1.5pt 6pt;
      background: var(--cv-accent-tint);
      border-radius: 2pt;
      color: var(--text);
    }

    /* ---- Languages ---- */
    .lang-table {
      display: grid;
      grid-template-columns: max-content 1fr;
      gap: 3pt 16pt;
      font-size: 10pt;
    }

    .lang-name { font-weight: 600; }
    .lang-level { color: var(--muted); }

    /* #621 — the visual margin now lives in @page (Chromium's paged-media
       engine re-applies it on every page); .page's own padding/size, which
       used to BE the margin on the print path, is neutralised in print so it
       doesn't double up with @page. Kept for the on-screen HTML preview
       above (width/min-height/padding), which never goes through @page. */
    @page {
      size: A4;
      margin: 14mm 18mm 14mm 18mm;
    }

    /* ---- Print ---- */
    @media print {
      body { background: #fff; }
      .page { padding: 0; width: auto; min-height: auto; margin: 0; }
    }
  </style>
</head>
<body>
<div class="page">

  <!-- ===== HEADER ===== -->
  <header class="header">
    <div class="header-inner">
      <div class="header-text">
        <div class="header-name">
          <h1>{{ cv.contact.name }}</h1>
        </div>
        <div class="header-contact">
          {% if cv.contact.location %}<div>{{ cv.contact.location }}</div>{% endif %}
          {% if cv.contact.phone %}<div>{{ cv.contact.phone }}</div>{% endif %}
          {% if cv.contact.email %}<div>{{ cv.contact.email }}</div>{% endif %}
          {% if cv.contact.linkedin %}<div>{{ cv.contact.linkedin }}</div>{% endif %}
        </div>
      </div>
      {% if cv.show_photo and cv.contact.photo_url %}
      <div class="header-avatar">
        <img src="{{ cv.contact.photo_url }}" alt="Profile photo">
      </div>
      {% endif %}
    </div>
  </header>

  <!-- ===== PROFESSIONAL PROFILE / BERUFLICHES PROFIL ===== -->
  {% if cv.summary %}
  <section class="section">
    <div class="section-header">
      <span class="section-title-en">{{ labels.summary }}</span>
      <div class="section-rule"></div>
    </div>
    <p class="summary-text">{{ cv.summary }}</p>
  </section>
  {% endif %}

  <!-- ===== EXPERIENCE / BERUFSERFAHRUNG ===== -->
  {% if cv.work_history %}
  <section class="section">
    <div class="section-header">
      <span class="section-title-en">{{ labels.experience }}</span>
      <div class="section-rule"></div>
    </div>
    {% for job in cv.work_history %}
    {% set n_bullets = job.bullets | length %}
    <div class="entry{{ ' entry-atomic' if n_bullets <= 3 else '' }}">
      {% set head %}
      <div class="entry-meta">
        <div class="entry-title">{{ job.role }}</div>
        <div class="entry-dates">{{ job.start_date | month_year }} – {{ job.end_date | month_year if job.end_date else labels.present }}</div>
      </div>
      <div class="entry-subtitle">{{ job.company }}</div>
      {% set role_facts = [] %}
      {% if job.team_size is not none %}{% set _ = role_facts.append(labels.role_team_size ~ ': ' ~ job.team_size) %}{% endif %}
      {% set budget_text = job.budget_managed | budget_display(lang) %}{% if budget_text %}{% set _ = role_facts.append(labels.role_budget ~ ': ' ~ budget_text) %}{% endif %}
      {% if job.industry_context %}{% set _ = role_facts.append(labels.role_industry ~ ': ' ~ job.industry_context) %}{% endif %}
      {% if role_facts %}
      <div class="entry-facts">{{ role_facts | join(' · ') }}</div>
      {% endif %}
      {% endset %}
      {% if n_bullets > 3 %}
      <div class="entry-lead">
        {{ head }}
        <ul class="entry-bullets">
          {% for bullet in job.bullets[:2] %}
          <li>{{ bullet }}</li>
          {% endfor %}
        </ul>
      </div>
      {% if n_bullets > 4 %}
      <ul class="entry-bullets">
        {% for bullet in job.bullets[2:-2] %}
        <li>{{ bullet }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      <div class="entry-tail">
        <ul class="entry-bullets">
          {% for bullet in job.bullets[-2:] %}
          <li>{{ bullet }}</li>
          {% endfor %}
        </ul>
      </div>
      {% else %}
      {{ head }}
      {% if job.bullets %}
      <ul class="entry-bullets">
        {% for bullet in job.bullets %}
        <li>{{ bullet }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      {% endif %}
      {% if job.projects %}
      <div class="entry-projects">
        <div class="entry-projects-title">{{ labels.projects }}</div>
        {% for project in job.projects %}
        <div class="project-item">
          <div class="project-name">{{ project.name }}</div>
          {% if project.bullets %}
          <ul class="entry-bullets">
            {% for bullet in project.bullets %}<li>{{ bullet }}</li>{% endfor %}
          </ul>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  <!-- ===== PROJECTS / PROJEKTE (standalone) ===== -->
  {% if cv.projects %}
  <section class="section">
    <div class="section-header">
      <span class="section-title-en">{{ labels.projects }}</span>
      <div class="section-rule"></div>
    </div>
    {% for project in cv.projects %}
    {% set n_bullets = project.bullets | length %}
    <div class="entry{{ ' entry-atomic' if n_bullets <= 3 else '' }}">
      {% if n_bullets > 3 %}
      <div class="entry-lead">
        <div class="entry-meta">
          <div class="entry-title">{{ project.name }}</div>
        </div>
        <ul class="entry-bullets">
          {% for bullet in project.bullets[:2] %}<li>{{ bullet }}</li>{% endfor %}
        </ul>
      </div>
      {% if n_bullets > 4 %}
      <ul class="entry-bullets">
        {% for bullet in project.bullets[2:-2] %}<li>{{ bullet }}</li>{% endfor %}
      </ul>
      {% endif %}
      <div class="entry-tail">
        <ul class="entry-bullets">
          {% for bullet in project.bullets[-2:] %}<li>{{ bullet }}</li>{% endfor %}
        </ul>
      </div>
      {% else %}
      <div class="entry-meta">
        <div class="entry-title">{{ project.name }}</div>
      </div>
      {% if project.bullets %}
      <ul class="entry-bullets">
        {% for bullet in project.bullets %}<li>{{ bullet }}</li>{% endfor %}
      </ul>
      {% endif %}
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  <!-- ===== EDUCATION / AUSBILDUNG ===== -->
  {% if cv.education %}
  {% set n_edu = cv.education | length %}
  <section class="section{{ ' section-atomic' if n_edu <= 6 else '' }}">
    {% if n_edu > 6 %}<div class="section-lead">{% endif %}
    <div class="section-header">
      <span class="section-title-en">{{ labels.education }}</span>
      <div class="section-rule"></div>
    </div>
    {% for edu in cv.education %}
    {% if n_edu > 6 and loop.index == 3 %}</div>{% endif %}
    {% if n_edu > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
    <div class="entry entry-atomic">
      <div class="entry-meta">
        <div class="entry-title">{{ edu.degree | education_title(edu.field) }}</div>
        <div class="entry-dates">{{ edu.start_date | month_year }}{% if edu.start_date %} – {% endif %}{{ edu.end_date | month_year if edu.end_date else (labels.present if edu.start_date else "") }}</div>
      </div>
      <div class="entry-subtitle">{{ edu.institution }}</div>
    </div>
    {% endfor %}
    {% if n_edu > 6 %}</div>{% endif %}
  </section>
  {% endif %}

  <!-- ===== CERTIFICATIONS / ZERTIFIZIERUNGEN ===== -->
  {% if cv.certifications %}
  {% set n_certs = cv.certifications | length %}
  <section class="section{{ ' section-atomic' if n_certs <= 6 else '' }}">
    {% if n_certs > 6 %}<div class="section-lead">{% endif %}
    <div class="section-header">
      <span class="section-title-en">{{ labels.certifications }}</span>
      <div class="section-rule"></div>
    </div>
    {% for cert in cv.certifications %}
    {% if n_certs > 6 and loop.index == 3 %}</div>{% endif %}
    {% if n_certs > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
    <div class="entry entry-atomic">
      <div class="entry-meta">
        <div class="entry-title">{{ cert.name }}</div>
        <div class="entry-dates">{{ cert.date_obtained | month_year }}</div>
      </div>
      {% if cert.issuing_organization %}<div class="entry-subtitle">{{ cert.issuing_organization }}</div>{% endif %}
    </div>
    {% endfor %}
    {% if n_certs > 6 %}</div>{% endif %}
  </section>
  {% endif %}

  <!-- ===== SKILLS / KENNTNISSE ===== -->
  {% if cv.skills %}
  {% set n_skills = cv.skills | length %}
  <section class="section{{ ' section-atomic' if n_skills <= 6 else '' }}">
    {% if n_skills > 6 %}<div class="section-lead">{% endif %}
    <div class="section-header">
      <span class="section-title-en">{{ labels.skills }}</span>
      <div class="section-rule"></div>
    </div>
    <ul class="skills-grid">
      {% for skill in cv.skills %}
      {% if n_skills > 6 and loop.index == 3 %}</ul></div><ul class="skills-grid">{% endif %}
      {% if n_skills > 6 and loop.revindex == 2 %}</ul><div class="section-tail"><ul class="skills-grid">{% endif %}
      <li>{{ skill }}</li>
      {% endfor %}
    </ul>
    {% if n_skills > 6 %}</div>{% endif %}
  </section>
  {% endif %}

  <!-- ===== LANGUAGES / SPRACHEN =====
       #622 scope note: this template renders each language as two bare
       <span> siblings inside a CSS grid (.lang-table), not one element per
       item — there is no single node to wrap for a per-item .entry-atomic
       or a >6 lead/tail split without breaking the grid's auto-placement.
       Falls back to whole-section atomicity for any item count (still
       strictly better than #622's "before": no protection at all). See the
       report. -->
  {% if cv.languages %}
  <section class="section section-atomic">
    <div class="section-header">
      <span class="section-title-en">{{ labels.languages }}</span>
      <div class="section-rule"></div>
    </div>
    <div class="lang-table">
      {% for lang in cv.languages %}
      <span class="lang-name">{{ lang.language }}</span>
      <span class="lang-level">{{ lang.level }}</span>
      {% endfor %}
    </div>
  </section>
  {% endif %}

</div>
</body>
</html>
