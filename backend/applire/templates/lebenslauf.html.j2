<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ labels.document_title }} – {{ cv.contact.name }}</title>
  <style>
    /* -----------------------------------------------------------------------
       Classic German Lebenslauf — A4, print-optimised
       ----------------------------------------------------------------------- */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cv-accent: {{ color.accent }};
      --cv-accent-tint: {{ color.tint }};
    }

    body {
      font-family: "Times New Roman", Times, serif;
      font-size: 11pt;
      line-height: 1.45;
      color: #1a1a1a;
      background: #fff;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      padding: 20mm 20mm 18mm 22mm;
    }

    /* Header */
    .header {
      border-bottom: 2px solid #1a1a1a;
      padding-bottom: 8pt;
      margin-bottom: 14pt;
    }

    .header h1 {
      font-size: 20pt;
      font-weight: bold;
      letter-spacing: 0.03em;
      margin-bottom: 4pt;
    }

    .header-contact {
      display: flex;
      flex-wrap: wrap;
      gap: 0 18pt;
      font-size: 9.5pt;
      color: #333;
    }

    .header-contact span::before {
      content: "";
    }

    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 14pt;
    }
    .header-text { flex: 1; }
    .header-photo {
      flex-shrink: 0;
      width: 45mm;
      height: 55mm;
      overflow: hidden;
      border-radius: 2pt;
    }
    .header-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
    }

    /* Sections */
    .section {
      margin-bottom: 14pt;
    }

    .section-title {
      font-size: 11pt;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      border-bottom: 1px solid var(--cv-accent);
      padding-bottom: 2pt;
      margin-bottom: 8pt;
      /* #357 — a section heading never orphans at the foot of a page. */
      break-after: avoid;
      page-break-after: avoid;
    }

    /* Two-column layout: date column | content column */
    .entry {
      display: flex;
      gap: 12pt;
      margin-bottom: 8pt;
      /* #357/#622 — a SHORT position block (<=3 bullets, class .entry-atomic
         below) stays one unit, DACH convention. A LONG block (>3 bullets)
         may now break — see .entry-lead/.entry-tail. */
    }

    /* #622 — break policy. SHORT entries (<=3 bullets, and every education/
       certification entry, which never carries bullets) stay atomic, same as
       #357. LONG entries (>3 bullets) may break, but the head (title/company/
       dates) + first 2 bullets is one keep-together group (.entry-lead), the
       last 2 bullets are another (.entry-tail), and every remaining bullet is
       itself atomic (.entry li) — never mid-sentence. List sections
       (certifications/education/...) follow the same shape at the item
       level via .section-atomic/.section-lead/.section-tail below, so a
       heading or a single stranded item never sits alone at a page foot. */
    .entry-atomic {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .entry-lead,
    .entry-tail {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .section li {
      /* covers .entry-bullets li (nested in .entry, itself in .section) AND
         list-section items rendered as bare <li> (e.g. skills-list) */
      break-inside: avoid;
      page-break-inside: avoid;
    }
    /* Split bullet lists must read as ONE continuous list, not three
       separately-spaced ones — only the first fragment (inside .entry-lead,
       right after the head text) keeps entry-bullets' normal margin-top. */
    .entry-lead ~ .entry-bullets,
    .entry-tail .entry-bullets {
      margin-top: 0;
    }
    /* D-35: a SHORT project (<=3 bullets) stays one unit; a LONG one keeps its
       name + first 2 bullets together (.project-lead) and may break after. */
    .project-atomic,
    .project-lead {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .project-lead ~ .entry-bullets { margin-top: 0; }
    /* D-35: the nested projects never open a page without their role — the
       block before them (the role's lead or tail) travels with their first block. */
    .entry-projects {
      break-before: avoid;
      page-break-before: avoid;
    }
    /* D-35: when projects follow, a long role's last 2 bullets are no longer one
       unit — only the LAST bullet travels with the projects, so the break costs
       one bullet's height, not two. */
    .entry-tail.entry-tail-open {
      break-inside: auto;
      page-break-inside: auto;
    }
    .section-atomic {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .section-lead,
    .section-tail {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .entry-dates {
      width: 28mm;
      flex-shrink: 0;
      font-size: 10pt;
      color: #444;
      padding-top: 1pt;
    }

    .entry-body {
      flex: 1;
    }

    .entry-title {
      font-weight: bold;
      font-size: 11pt;
    }

    .entry-subtitle {
      font-size: 10pt;
      color: #333;
      margin-bottom: 3pt;
    }

    /* Quantified role facts (#328) — deterministic furniture, never prose */
    .entry-facts {
      font-size: 9.5pt;
      color: #444;
      margin-bottom: 3pt;
    }

    .entry-bullets {
      margin-top: 3pt;
      padding-left: 14pt;
      list-style-type: disc;
    }

    .entry-bullets li {
      margin-bottom: 1.5pt;
      font-size: 10.5pt;
    }

    /* Projects nested under a position */
    .entry-projects { margin-top: 4pt; }
    .entry-projects-title {
      /* D-6 (delivery run 4): the sub-label moves with its first project — never alone at a page foot. */
      break-after: avoid;
      page-break-after: avoid;
      font-size: 9.5pt;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--cv-accent);
      margin-bottom: 2pt;
    }
    .project-item { margin-bottom: 3pt; }
    .project-name { font-weight: bold; font-size: 10.5pt; }

    /* Summary */
    .summary-text {
      font-size: 10.5pt;
      line-height: 1.5;
    }

    /* Skills */
    .skills-list {
      display: flex;
      flex-wrap: wrap;
      gap: 4pt 10pt;
      list-style: none;
    }

    .skills-list li {
      font-size: 10.5pt;
      /* U-10: a chip never splits across pages; rows break between chips. */
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .skills-list li::before {
      content: "▪ ";
      color: #555;
    }

    /* Languages */
    .lang-entry {
      display: flex;
      gap: 6pt;
      font-size: 10.5pt;
      margin-bottom: 2pt;
    }

    .lang-name { font-weight: bold; }
    .lang-level { color: #444; }

    /* Signature (#F frontend, Nougat build 2) */
    .signature-block { break-inside: avoid; page-break-inside: avoid; margin-top: 8mm; }
    .signature-block .signature-place-date { margin-bottom: 2mm; }
    .signature-block .signature-image { display: block; height: 14mm; width: auto; max-width: 60mm; }

    /* #621 — the visual margin now lives in @page (Chromium's paged-media
       engine re-applies it on every page); .page's own padding/size, which
       used to BE the margin on the print path, is neutralised in print so it
       doesn't double up with @page. Kept for the on-screen HTML preview
       above (width/min-height/padding), which never goes through @page. */
    @page {
      size: A4;
      margin: 15mm 18mm 15mm 20mm;
    }

    /* Print */
    @media print {
      body { background: #fff; }
      .page { padding: 0; width: auto; min-height: auto; margin: 0; }
    }
  </style>
</head>
<body>
<div class="page">

  <!-- ===== HEADER ===== -->
  <header class="header">
    <div class="header-inner">
      <div class="header-text">
        <h1>{{ cv.contact.name }}</h1>
        <div class="header-contact">
          {% if cv.contact.location %}<span>{{ cv.contact.location }}</span>{% endif %}
          {% if cv.contact.phone %}<span>{{ cv.contact.phone }}</span>{% endif %}
          {% if cv.contact.email %}<span>{{ cv.contact.email }}</span>{% endif %}
          {% if cv.contact.linkedin %}<span>{{ cv.contact.linkedin }}</span>{% endif %}
        </div>
      </div>
      {% if cv.show_photo and cv.contact.photo_url %}
      <div class="header-photo">
        <img src="{{ cv.contact.photo_url }}" alt="Bewerbungsfoto">
      </div>
      {% endif %}
    </div>
  </header>

  <!-- ===== BERUFLICHES PROFIL / SUMMARY ===== -->
  {% if cv.summary %}
  <section class="section">
    <h2 class="section-title">{{ labels.summary }}</h2>
    <p class="summary-text">{{ cv.summary }}</p>
  </section>
  {% endif %}

  <!-- ===== BERUFSERFAHRUNG ===== -->
  {% if cv.work_history %}
  <section class="section">
    <h2 class="section-title">{{ labels.experience }}</h2>
    {% for job in cv.work_history %}
    {% set n_bullets = job.bullets | length %}
    {# D-35: an entry is atomic only when ALL of it is short — its own bullets
       PLUS its nested projects' bullets (a 2-bullet role with a 5-bullet project
       was one unbreakable block and left page 1 ~40 % empty). #}
    {% set n_proj_bullets = job.projects | map(attribute='bullets') | map('length') | sum %}
    <div class="entry{{ ' entry-atomic' if n_bullets + n_proj_bullets <= 3 else '' }}">
      <div class="entry-dates">
        {% set job_period = job | period(labels.present) %}{{ job_period.start }}{% if job_period.dash %}&nbsp;–&nbsp;{% endif %}{{ job_period.end }}
      </div>
      <div class="entry-body">
        {% set head %}
        <div class="entry-title">{{ job.role }}</div>
        <div class="entry-subtitle">{{ job.company }}</div>
        {# Founder ruling P-1: one fact line, numbers only, no labels, no industry
           (filters.role_facts — shared with the .docx export). #}
        {% set role_facts_text = job | role_facts(lang) %}
        {% if role_facts_text %}
        <div class="entry-facts">{{ role_facts_text }}</div>
        {% endif %}
        {% endset %}
        {% if n_bullets > 3 %}
        {# #622 — LONG entry: head + first 2 bullets keep together, last 2
           bullets keep together, every middle bullet is atomic on its own. #}
        <div class="entry-lead">
          {{ head }}
          <ul class="entry-bullets">
            {% for bullet in job.bullets[:2] %}
            <li>{{ bullet }}</li>
            {% endfor %}
          </ul>
        </div>
        {% if n_bullets > 4 %}
        <ul class="entry-bullets">
          {% for bullet in job.bullets[2:-2] %}
          <li>{{ bullet }}</li>
          {% endfor %}
        </ul>
        {% endif %}
        <div class="entry-tail{{ ' entry-tail-open' if job.projects else '' }}">
          <ul class="entry-bullets">
            {% for bullet in job.bullets[-2:] %}
            <li>{{ bullet }}</li>
            {% endfor %}
          </ul>
        </div>
        {% else %}
        {% if job.projects and n_bullets + n_proj_bullets > 3 %}
        {# D-35: a short role WITH nested projects breaks like a long one — head +
           first 2 own bullets keep together (.entry-lead), the rest follow, and the
           projects travel with the block before them (.entry-projects
           break-before: avoid): they never open a page on their own. #}
        <div class="entry-lead">
          {{ head }}
          {% if job.bullets %}<ul class="entry-bullets">{% for bullet in job.bullets[:2] %}<li>{{ bullet }}</li>{% endfor %}</ul>{% endif %}
        </div>
        {% if n_bullets > 2 %}<ul class="entry-bullets">{% for bullet in job.bullets[2:] %}<li>{{ bullet }}</li>{% endfor %}</ul>{% endif %}
        {% else %}
        {{ head }}
        {% if job.bullets %}
        <ul class="entry-bullets">
          {% for bullet in job.bullets %}
          <li>{{ bullet }}</li>
          {% endfor %}
        </ul>
        {% endif %}
        {% endif %}
        {% endif %}
        {% if job.projects %}
        <div class="entry-projects">
          <div class="entry-projects-title">{{ labels.projects }}</div>
          {% for project in job.projects %}
          {% set n_pb = project.bullets | length %}
          <div class="project-item{{ ' project-atomic' if n_pb <= 1 else '' }}">
            {% if n_pb > 1 %}
            {# D-35: a project with more than one bullet may break — its name + first bullet keep together. #}
            <div class="project-lead">
              <div class="project-name">{{ project.name }}</div>
              <ul class="entry-bullets">{% for bullet in project.bullets[:1] %}<li>{{ bullet }}</li>{% endfor %}</ul>
            </div>
            <ul class="entry-bullets">{% for bullet in project.bullets[1:] %}<li>{{ bullet }}</li>{% endfor %}</ul>
            {% else %}
            <div class="project-name">{{ project.name }}</div>
            {% if project.bullets %}
            <ul class="entry-bullets">{% for bullet in project.bullets %}<li>{{ bullet }}</li>{% endfor %}</ul>
            {% endif %}
            {% endif %}
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  <!-- ===== PROJEKTE (standalone) ===== -->
  {% if cv.projects %}
  <section class="section">
    <h2 class="section-title">{{ labels.projects }}</h2>
    {% for project in cv.projects %}
    {% set n_bullets = project.bullets | length %}
    <div class="entry{{ ' entry-atomic' if n_bullets <= 3 else '' }}">
      <div class="entry-dates"></div>
      <div class="entry-body">
        {% if n_bullets > 3 %}
        <div class="entry-lead">
          <div class="entry-title">{{ project.name }}</div>
          <ul class="entry-bullets">
            {% for bullet in project.bullets[:2] %}
            <li>{{ bullet }}</li>
            {% endfor %}
          </ul>
        </div>
        {% if n_bullets > 4 %}
        <ul class="entry-bullets">
          {% for bullet in project.bullets[2:-2] %}
          <li>{{ bullet }}</li>
          {% endfor %}
        </ul>
        {% endif %}
        <div class="entry-tail">
          <ul class="entry-bullets">
            {% for bullet in project.bullets[-2:] %}
            <li>{{ bullet }}</li>
            {% endfor %}
          </ul>
        </div>
        {% else %}
        <div class="entry-title">{{ project.name }}</div>
        {% if project.bullets %}
        <ul class="entry-bullets">
          {% for bullet in project.bullets %}
          <li>{{ bullet }}</li>
          {% endfor %}
        </ul>
        {% endif %}
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  <!-- ===== AUSBILDUNG ===== -->
  {% if cv.education %}
  {% set n_edu = cv.education | length %}
  <section class="section{{ ' section-atomic' if n_edu <= 6 else '' }}">
    {% if n_edu > 6 %}<div class="section-lead">{% endif %}
    <h2 class="section-title">{{ labels.education }}</h2>
    {% for edu in cv.education %}
    {% if n_edu > 6 and loop.index == 3 %}</div>{% endif %}
    {% if n_edu > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
    <div class="entry entry-atomic">
      <div class="entry-dates">
        {% set edu_period = edu | period(labels.present) %}{{ edu_period.start }}{% if edu_period.dash %}&nbsp;–&nbsp;{% endif %}{{ edu_period.end }}
      </div>
      <div class="entry-body">
        <div class="entry-title">{{ edu.degree | education_title(edu.field) }}</div>
        <div class="entry-subtitle">{{ edu.institution }}</div>
      </div>
    </div>
    {% endfor %}
    {% if n_edu > 6 %}</div>{% endif %}
  </section>
  {% endif %}

  <!-- ===== ZERTIFIZIERUNGEN ===== -->
  {% if cv.certifications %}
  {% set n_certs = cv.certifications | length %}
  <section class="section{{ ' section-atomic' if n_certs <= 6 else '' }}">
    {% if n_certs > 6 %}<div class="section-lead">{% endif %}
    <h2 class="section-title">{{ labels.certifications }}</h2>
    {% for cert in cv.certifications %}
    {% if n_certs > 6 and loop.index == 3 %}</div>{% endif %}
    {% if n_certs > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
    <div class="entry entry-atomic">
      <div class="entry-dates">{{ cert.date_obtained | month_year }}</div>
      <div class="entry-body">
        <div class="entry-title">{{ cert.name }}</div>
        {% if cert.issuing_organization %}<div class="entry-subtitle">{{ cert.issuing_organization }}</div>{% endif %}
      </div>
    </div>
    {% endfor %}
    {% if n_certs > 6 %}</div>{% endif %}
  </section>
  {% endif %}

  <!-- ===== KENNTNISSE ===== -->
  {% if cv.skills %}
  {% set n_skills = cv.skills | length %}
  {# U-10 (Hazelnut b5): ONE wrapping chip list — see modern_swiss.html.j2. #}
  <section class="section{{ ' section-atomic' if n_skills <= 6 else '' }}">
    <h2 class="section-title">{{ labels.skills }}</h2>
    <ul class="skills-list">
      {% for skill in cv.skills %}
      <li>{{ skill }}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <!-- ===== SPRACHEN ===== -->
  {% if cv.languages %}
  {% set n_langs = cv.languages | length %}
  <section class="section{{ ' section-atomic' if n_langs <= 6 else '' }}">
    {% if n_langs > 6 %}<div class="section-lead">{% endif %}
    <h2 class="section-title">{{ labels.languages }}</h2>
    {% for lang in cv.languages %}
    {% if n_langs > 6 and loop.index == 3 %}</div>{% endif %}
    {% if n_langs > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
    <div class="lang-entry entry-atomic">
      <span class="lang-name">{{ lang.language }}:</span>
      <span class="lang-level">{{ lang.level }}</span>
    </div>
    {% endfor %}
    {% if n_langs > 6 %}</div>{% endif %}
  </section>
  {% endif %}

  {% if signature_image %}
  <div class="signature-block">
    {% if signature_place_date %}<div class="signature-place-date">{{ signature_place_date }}</div>{% endif %}
    <img class="signature-image" src="{{ signature_image }}" alt="">
  </div>
  {% endif %}

</div>
</body>
</html>
