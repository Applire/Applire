<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8" />
  <title>{{ labels.document_title }} – {{ cv.contact.name }}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cv-primary: {{ color.primary }};
      --cv-primary-tint: {{ color.primary_tint }};
      --cv-surface: {{ color.surface }};
      --cv-surface-text: {{ color.surface_text }};
      --text: #1c1c1c;
      --muted: #5a5a5a;
      --rule: #e0e0e0;
    }

    body {
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-size: 10pt;
      line-height: 1.5;
      color: var(--text);
      background: #fff;
    }

    /* P-5 (founder ruling, Hazelnut build 8): "Kreativ" has no column any more.
       The coloured side column painted on every page, empty from page 2, and the
       grid sat left (12 / 18 mm). Page 1 opens with a coloured band (round photo,
       name, contact); skills (chips) and languages form one block under the
       profile; every page runs at full width with symmetric 16 mm margins.
       The template id stays creative_sidebar (stored applications resolve it). */
    /* On screen (preview, thumbnail) the sheet carries the margin itself; in print
       the @page margin does (16 mm on every side) and .page is reset below. */
    .page { width: 210mm; min-height: 297mm; margin: 0 auto; padding: 16mm; }
    .hero {
      display: flex;
      align-items: center;
      gap: 9mm;
      background: var(--cv-surface);
      color: var(--cv-surface-text);
      padding: 8mm 10mm;
      border-radius: 2mm;
      margin-bottom: 8mm;
      break-inside: avoid;
      page-break-inside: avoid;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .hero-avatar {
      width: 30mm;
      height: 30mm;
      flex-shrink: 0;
      border-radius: 50%;
      overflow: hidden;
      border: 3px solid color-mix(in srgb, var(--cv-surface-text) 35%, transparent);
    }
    .hero-avatar img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
    .hero-name {
      font-size: 20pt;
      font-weight: bold;
      line-height: 1.2;
      color: var(--cv-surface-text);
      margin-bottom: 4pt;
    }
    .hero-contact {
      font-size: 9pt;
      line-height: 1.6;
      color: var(--cv-surface-text);
    }
    /* ADR-039: an opaque colour, never `opacity` (a sub-1 opacity layer made
       pypdf extract the text glyph by glyph and out of order). */
    .hero-contact span + span::before { content: "·"; margin: 0 6pt; color: color-mix(in srgb, var(--cv-surface-text) 60%, var(--cv-surface)); }

    .facts-block {
      display: grid;
      grid-template-columns: 1fr 48mm;
      gap: 9mm;
    }
    .chips { display: flex; flex-wrap: wrap; gap: 3pt 4pt; }
    .chip {
      font-size: 8.5pt;
      padding: 1pt 6pt;
      border-radius: 8pt;
      background: var(--cv-primary-tint);
      color: var(--text);
      line-height: 1.5;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .lang-item { font-size: 9.5pt; line-height: 1.6; }

    .main { }

    .section { margin-bottom: 14pt; }

    .section-title {
      font-size: 9.5pt;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--cv-primary);
      border-bottom: 2px solid var(--cv-primary);
      padding-bottom: 2pt;
      margin-bottom: 8pt;
      /* #357 — a section heading never orphans at the foot of a page. */
      break-after: avoid;
      page-break-after: avoid;
    }

    .entry {
      margin-bottom: 9pt;
      /* #357/#622 — a SHORT entry (<=3 bullets, class .entry-atomic below)
         stays one unit. A LONG entry (>3 bullets) may now break. */
    }

    /* #622 — break policy. SHORT entries (<=3 bullets, and every education/
       certification entry, which never carries bullets) stay atomic, same as
       #357. LONG entries (>3 bullets) may break, but the head (title/company/
       dates) + first 2 bullets is one keep-together group (.entry-lead), the
       last 2 bullets are another (.entry-tail), and every remaining bullet is
       itself atomic (.section li) — never mid-sentence. List sections
       (certifications/education/...) follow the same shape at the item
       level via .section-atomic/.section-lead/.section-tail below, so a
       heading or a single stranded item never sits alone at a page foot. */
    .entry-atomic {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .entry-lead,
    .entry-tail {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .section li {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .entry-lead ~ .entry-bullets,
    .entry-tail .entry-bullets {
      margin-top: 0;
    }
    /* D-35: a SHORT project (<=3 bullets) stays one unit; a LONG one keeps its
       name + first 2 bullets together (.project-lead) and may break after. */
    .project-atomic,
    .project-lead {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .project-lead ~ .entry-bullets { margin-top: 0; }
    /* D-35: the nested projects never open a page without their role — the
       block before them (the role's lead or tail) travels with their first block. */
    .entry-projects {
      break-before: avoid;
      page-break-before: avoid;
    }
    /* D-35: when projects follow, a long role's last 2 bullets are no longer one
       unit — only the LAST bullet travels with the projects, so the break costs
       one bullet's height, not two. */
    .entry-tail.entry-tail-open {
      break-inside: auto;
      page-break-inside: auto;
    }
    .section-atomic {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .section-lead,
    .section-tail {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .entry-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }

    .entry-title {
      font-size: 10.5pt;
      font-weight: bold;
      color: var(--text);
    }

    .entry-dates {
      font-size: 8.5pt;
      color: var(--muted);
      white-space: nowrap;
    }

    .entry-subtitle {
      font-size: 9.5pt;
      color: var(--muted);
      margin-bottom: 3pt;
    }

    /* Quantified role facts (#328) — deterministic furniture, never prose */
    .entry-facts {
      font-size: 8.5pt;
      color: var(--muted);
      margin-bottom: 3pt;
    }

    .entry-bullets {
      padding-left: 12pt;
      list-style-type: disc;
      margin-top: 3pt;
    }

    .entry-bullets li {
      margin-bottom: 2pt;
      font-size: 9.5pt;
    }

    .entry-projects { margin-top: 5pt; }
    .entry-projects-title {
      /* D-6 (delivery run 4): the sub-label moves with its first project — never alone at a page foot. */
      break-after: avoid;
      page-break-after: avoid;
      font-size: 8.5pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--cv-primary);
      margin-bottom: 2pt;
    }
    .project-item { margin-bottom: 3pt; }
    .project-name { font-weight: 700; font-size: 9.5pt; }

    .summary-text {
      font-size: 10pt;
      line-height: 1.55;
    }

    /* Signature (#F frontend, Nougat build 2) — lives in .main, never in the
       page-1 band; the band is contact furniture, not document content. */
    .signature-block { break-inside: avoid; page-break-inside: avoid; margin-top: 8mm; }
    .signature-block .signature-place-date { margin-bottom: 2mm; }
    .signature-block .signature-image { display: block; height: 14mm; width: auto; max-width: 60mm; }

    /* #621 / P-5: the page margin is the @page margin below (16 mm on every
       side). A colour cannot be painted into the @page margin, so the page-1 band
       sits inside it ("a printable margin beats bleed", #621 design point 3). */
    /* RU-3 (Hazelnut build 8, ruling P-4): long bullets made every keep-together
       unit tall (a 60-word bullet is ~10 lines) and each page break pushed a whole
       unit down — ~0.8 of a page blank over 5 pages. A bullet of 6 lines or more
       may now break with at least 3 lines on each page (a shorter bullet never
       splits); a head keeps only its first 3 lines with it; and a lead or tail that
       holds long bullets (.lead-long) is no longer one unit (amends #622 and
       D-35 cl. 1-3; the nested projects still never open a page alone). */
    /* Chromium keeps orphans but drops widows when a paragraph has fewer than
       orphans + widows lines (measured: 4 lines split 3/1, 5 lines 3/2). So a bullet
       may split only when it is surely 6+ lines: .li-split marks a bullet of at
       least split_chars characters (6 x this template's widest bullet line x 1.15);
       every other bullet stays one unit (#622). */
    .section .entry-bullets li {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .section .entry-bullets li.li-split {
      break-inside: auto;
      page-break-inside: auto;
      orphans: 3;
      widows: 3;
    }
    .entry-lead.lead-long,
    .entry-tail.lead-long,
    .project-lead.lead-long {
      break-inside: auto;
      page-break-inside: auto;
    }
    .entry-header,
    .entry-title,
    .entry-subtitle,
    .entry-facts,
    .project-name {
      break-after: avoid;
      page-break-after: avoid;
    }

    @page {
      size: A4;
      margin: 16mm 16mm 16mm 16mm;
    }

    @media print {
      .page { width: auto; min-height: auto; margin: 0; padding: 0; }
    }
  </style>
</head>
<body>
{# RU-3 (ruling P-4): an entry is one unbreakable unit only up to atomic_chars of
   bullet text; a lead/tail holding more than long_chars may break inside. #}
{% set atomic_chars = 400 %}{% set long_chars = 300 %}{% set split_chars = 760 %}
<div class="page">

  <header class="hero">
    {% if cv.show_photo and cv.contact.photo_url %}
    <div class="hero-avatar"><img src="{{ cv.contact.photo_url }}" alt="Foto"></div>
    {% endif %}
    <div>
      {# ADR-039: nowrap name tokens (a hyphenated surname never breaks at the hyphen). #}
      <div class="hero-name">{% for tok in cv.contact.name.split() %}<span style="white-space: nowrap;">{{ tok }}</span>{% if not loop.last %} {% endif %}{% endfor %}</div>
      <div class="hero-contact">{% if cv.contact.location %}<span>{{ cv.contact.location }}</span>{% endif %}{% if cv.contact.phone %}<span>{{ cv.contact.phone }}</span>{% endif %}{% if cv.contact.email %}<span>{{ cv.contact.email }}</span>{% endif %}{% if cv.contact.linkedin %}<span>{{ cv.contact.linkedin }}</span>{% endif %}</div>
    </div>
  </header>

  <main class="main">
    {% if cv.summary %}
    <div class="section">
      <div class="section-title">{{ labels.summary }}</div>
      <p class="summary-text">{{ cv.summary }}</p>
    </div>
    {% endif %}

    {% if cv.skills or cv.languages %}
    <div class="section facts-block section-atomic">
      {% if cv.skills %}<div>
        <div class="section-title">{{ labels.skills }}</div>
        <div class="chips">{% for skill in cv.skills %}<span class="chip">{{ skill }}</span>{% endfor %}</div>
      </div>{% endif %}
      {% if cv.languages %}<div>
        <div class="section-title">{{ labels.languages }}</div>
        {% for lang in cv.languages %}<div class="lang-item">{{ lang.language }} · {{ lang.level }}</div>{% endfor %}
      </div>{% endif %}
    </div>
    {% endif %}

    {% if cv.work_history %}
    <div class="section">
      <div class="section-title">{{ labels.experience }}</div>
      {% for job in cv.work_history %}
      {% set n_bullets = job.bullets | length %}
      {# D-35: an entry is atomic only when ALL of it is short — its own bullets
         PLUS its nested projects' bullets (a 2-bullet role with a 5-bullet project
         was one unbreakable block and left page 1 ~40 % empty). #}
      {% set n_proj_bullets = job.projects | map(attribute='bullets') | map('length') | sum %}
      {% set n_chars = (job.bullets | join(' ') | length) + (job.projects | map(attribute='bullets') | map('join', ' ') | map('length') | sum) %}
      {% set short = n_bullets + n_proj_bullets <= 3 and n_chars <= atomic_chars %}
      <div class="entry{{ ' entry-atomic' if short else '' }}">
        {% set head %}
        <div class="entry-header">
          <div class="entry-title">{{ job.role }}</div>
          <div class="entry-dates">{% set job_period = job | period(labels.present) %}{{ job_period.start }}{% if job_period.dash %} – {% endif %}{{ job_period.end }}</div>
        </div>
        <div class="entry-subtitle">{{ job.company }}</div>
        {# Founder ruling P-1: one fact line, numbers only, no labels, no industry
           (filters.role_facts — shared with the .docx export). #}
        {% set role_facts_text = job | role_facts(lang) %}
        {% if role_facts_text %}
        <div class="entry-facts">{{ role_facts_text }}</div>
        {% endif %}
        {% endset %}
        {% if n_bullets > 3 %}
        <div class="entry-lead{{ ' lead-long' if (job.bullets[:2] | join(' ') | length) > long_chars else '' }}">
          {{ head }}
          <ul class="entry-bullets">
            {% for bullet in job.bullets[:2] %}
            <li{% if (bullet | length) >= split_chars %} class="li-split"{% endif %}>{{ bullet }}</li>
            {% endfor %}
          </ul>
        </div>
        {% if n_bullets > 4 %}
        <ul class="entry-bullets">
          {% for bullet in job.bullets[2:-2] %}
          <li{% if (bullet | length) >= split_chars %} class="li-split"{% endif %}>{{ bullet }}</li>
          {% endfor %}
        </ul>
        {% endif %}
        <div class="entry-tail{{ ' entry-tail-open' if job.projects else '' }}{{ ' lead-long' if (job.bullets[-2:] | join(' ') | length) > long_chars else '' }}">
          <ul class="entry-bullets">
            {% for bullet in job.bullets[-2:] %}
            <li{% if (bullet | length) >= split_chars %} class="li-split"{% endif %}>{{ bullet }}</li>
            {% endfor %}
          </ul>
        </div>
        {% else %}
        {% if not short %}
        {# D-35 / RU-3 (P-4): a role that is not short (nested projects, or long text)
           breaks: only the head + FIRST own bullet keep together (.entry-lead), and
           the projects may open a page with their title. #}
        <div class="entry-lead{{ ' lead-long' if (job.bullets[:1] | join(' ') | length) > long_chars else '' }}">
          {{ head }}
          {% if job.bullets %}<ul class="entry-bullets">{% for bullet in job.bullets[:1] %}<li{% if (bullet | length) >= split_chars %} class="li-split"{% endif %}>{{ bullet }}</li>{% endfor %}</ul>{% endif %}
        </div>
        {% if n_bullets > 1 %}<ul class="entry-bullets">{% for bullet in job.bullets[1:] %}<li{% if (bullet | length) >= split_chars %} class="li-split"{% endif %}>{{ bullet }}</li>{% endfor %}</ul>{% endif %}
        {% else %}
        {{ head }}
        {% if job.bullets %}
        <ul class="entry-bullets">
          {% for bullet in job.bullets %}
          <li{% if (bullet | length) >= split_chars %} class="li-split"{% endif %}>{{ bullet }}</li>
          {% endfor %}
        </ul>
        {% endif %}
        {% endif %}
        {% endif %}
        {% if job.projects %}
        <div class="entry-projects">
          <div class="entry-projects-title">{{ labels.projects }}</div>
          {% for project in job.projects %}
          {% set n_pb = project.bullets | length %}
          <div class="project-item{{ ' project-atomic' if n_pb <= 1 and (project.bullets | join(' ') | length) <= long_chars else '' }}">
            {% if n_pb > 1 %}
            {# D-35: a project with more than one bullet may break — its name + first bullet keep together. #}
            <div class="project-lead{{ ' lead-long' if (project.bullets[:1] | join(' ') | length) > long_chars else '' }}">
              <div class="project-name">{{ project.name }}</div>
              <ul class="entry-bullets">{% for bullet in project.bullets[:1] %}<li{% if (bullet | length) >= split_chars %} class="li-split"{% endif %}>{{ bullet }}</li>{% endfor %}</ul>
            </div>
            <ul class="entry-bullets">{% for bullet in project.bullets[1:] %}<li{% if (bullet | length) >= split_chars %} class="li-split"{% endif %}>{{ bullet }}</li>{% endfor %}</ul>
            {% else %}
            <div class="project-name">{{ project.name }}</div>
            {% if project.bullets %}
            <ul class="entry-bullets">{% for bullet in project.bullets %}<li{% if (bullet | length) >= split_chars %} class="li-split"{% endif %}>{{ bullet }}</li>{% endfor %}</ul>
            {% endif %}
            {% endif %}
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if cv.projects %}
    <div class="section">
      <div class="section-title">{{ labels.projects }}</div>
      {% for project in cv.projects %}
      {% set n_bullets = project.bullets | length %}
      <div class="entry{{ ' entry-atomic' if n_bullets <= 3 and (project.bullets | join(' ') | length) <= atomic_chars else '' }}">
        {% if n_bullets > 3 %}
        <div class="entry-lead{{ ' lead-long' if (project.bullets[:2] | join(' ') | length) > long_chars else '' }}">
          <div class="entry-header">
            <div class="entry-title">{{ project.name }}</div>
          </div>
          <ul class="entry-bullets">
            {% for bullet in project.bullets[:2] %}<li{% if (bullet | length) >= split_chars %} class="li-split"{% endif %}>{{ bullet }}</li>{% endfor %}
          </ul>
        </div>
        {% if n_bullets > 4 %}
        <ul class="entry-bullets">
          {% for bullet in project.bullets[2:-2] %}<li{% if (bullet | length) >= split_chars %} class="li-split"{% endif %}>{{ bullet }}</li>{% endfor %}
        </ul>
        {% endif %}
        <div class="entry-tail{{ ' lead-long' if (project.bullets[-2:] | join(' ') | length) > long_chars else '' }}">
          <ul class="entry-bullets">
            {% for bullet in project.bullets[-2:] %}<li{% if (bullet | length) >= split_chars %} class="li-split"{% endif %}>{{ bullet }}</li>{% endfor %}
          </ul>
        </div>
        {% else %}
        <div class="entry-header">
          <div class="entry-title">{{ project.name }}</div>
        </div>
        {% if project.bullets %}
        <ul class="entry-bullets">
          {% for bullet in project.bullets %}<li{% if (bullet | length) >= split_chars %} class="li-split"{% endif %}>{{ bullet }}</li>{% endfor %}
        </ul>
        {% endif %}
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if cv.education %}
    {% set n_edu = cv.education | length %}
    <div class="section{{ ' section-atomic' if n_edu <= 6 else '' }}">
      {% if n_edu > 6 %}<div class="section-lead">{% endif %}
      <div class="section-title">{{ labels.education }}</div>
      {% for edu in cv.education %}
      {% if n_edu > 6 and loop.index == 3 %}</div>{% endif %}
      {% if n_edu > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
      <div class="entry entry-atomic">
        <div class="entry-header">
          <div class="entry-title">{{ edu.degree | education_title(edu.field) }}</div>
          <div class="entry-dates">{% set edu_period = edu | period(labels.present, "education") %}{{ edu_period.start }}{% if edu_period.dash %} – {% endif %}{{ edu_period.end }}</div>
        </div>
        <div class="entry-subtitle">{{ edu.institution }}</div>
      </div>
      {% endfor %}
      {% if n_edu > 6 %}</div>{% endif %}
    </div>
    {% endif %}

    {% if cv.certifications %}
    {% set n_certs = cv.certifications | length %}
    <div class="section{{ ' section-atomic' if n_certs <= 6 else '' }}">
      {% if n_certs > 6 %}<div class="section-lead">{% endif %}
      <div class="section-title">{{ labels.certifications }}</div>
      {% for cert in cv.certifications %}
      {% if n_certs > 6 and loop.index == 3 %}</div>{% endif %}
      {% if n_certs > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
      <div class="entry entry-atomic">
        <div class="entry-header">
          <div class="entry-title">{{ cert.name }}</div>
          <div class="entry-dates">{{ cert.date_obtained | month_year }}</div>
        </div>
        {% if cert.issuing_organization %}<div class="entry-subtitle">{{ cert.issuing_organization }}</div>{% endif %}
      </div>
      {% endfor %}
      {% if n_certs > 6 %}</div>{% endif %}
    </div>
    {% endif %}

    {% if signature_image %}
    <div class="signature-block">
      {% if signature_place_date %}<div class="signature-place-date">{{ signature_place_date }}</div>{% endif %}
      <img class="signature-image" src="{{ signature_image }}" alt="">
    </div>
    {% endif %}
  </main>

</div>
</body>
</html>
