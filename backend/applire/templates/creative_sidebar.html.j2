<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8" />
  <title>{{ labels.document_title }} – {{ cv.contact.name }}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cv-primary: {{ color.primary }};
      --cv-primary-tint: {{ color.primary_tint }};
      --cv-surface: {{ color.surface }};
      --cv-surface-text: {{ color.surface_text }};
      --text: #1c1c1c;
      --muted: #5a5a5a;
      --rule: #e0e0e0;
    }

    body {
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-size: 10pt;
      line-height: 1.5;
      color: var(--text);
      background: #fff;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      display: flex;
    }

    .sidebar {
      width: 68mm;
      background: var(--cv-surface);
      color: var(--cv-surface-text);
      padding: 20mm 12mm 16mm 12mm;
      flex-shrink: 0;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .sidebar-avatar {
      width: 40mm;
      height: 40mm;
      border-radius: 50%;
      overflow: hidden;
      margin: 0 auto 10pt;
      border: 3px solid color-mix(in srgb, var(--cv-surface-text) 35%, transparent);
    }
    .sidebar-avatar img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }

    .sidebar-avatar-placeholder {
      width: 40mm;
      height: 40mm;
      border-radius: 50%;
      background: color-mix(in srgb, var(--cv-surface-text) 20%, transparent);
      margin: 0 auto 10pt;
    }

    .sidebar-name {
      font-size: 12pt;
      font-weight: bold;
      text-align: center;
      color: var(--cv-surface-text);
      margin-bottom: 4pt;
    }

    .sidebar-section { margin-top: 14pt; }

    .sidebar-section-title {
      font-size: 7pt;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--cv-surface-text);
      opacity: 0.65;
      border-bottom: 1px solid color-mix(in srgb, var(--cv-surface-text) 25%, transparent);
      padding-bottom: 3pt;
      margin-bottom: 6pt;
      /* #357 — a section heading never orphans at the foot of a page. */
      break-after: avoid;
      page-break-after: avoid;
    }

    .sidebar-item {
      font-size: 8.5pt;
      color: var(--cv-surface-text);
      line-height: 1.7;
    }

    .sidebar-skill {
      font-size: 8.5pt;
      color: var(--cv-surface-text);
      padding: 1.5pt 0;
      border-bottom: 1px solid color-mix(in srgb, var(--cv-surface-text) 15%, transparent);
      line-height: 1.5;
    }

    .main {
      flex: 1;
      padding: 20mm 18mm 16mm 16mm;
    }

    .section { margin-bottom: 14pt; }

    .section-title {
      font-size: 9.5pt;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--cv-primary);
      border-bottom: 2px solid var(--cv-primary);
      padding-bottom: 2pt;
      margin-bottom: 8pt;
      /* #357 — a section heading never orphans at the foot of a page. */
      break-after: avoid;
      page-break-after: avoid;
    }

    .entry {
      margin-bottom: 9pt;
      /* #357/#622 — a SHORT entry (<=3 bullets, class .entry-atomic below)
         stays one unit. A LONG entry (>3 bullets) may now break. */
    }

    /* #622 — break policy. SHORT entries (<=3 bullets, and every education/
       certification entry, which never carries bullets) stay atomic, same as
       #357. LONG entries (>3 bullets) may break, but the head (title/company/
       dates) + first 2 bullets is one keep-together group (.entry-lead), the
       last 2 bullets are another (.entry-tail), and every remaining bullet is
       itself atomic (.section li) — never mid-sentence. List sections
       (certifications/education/...) follow the same shape at the item
       level via .section-atomic/.section-lead/.section-tail below, so a
       heading or a single stranded item never sits alone at a page foot. */
    .entry-atomic {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .entry-lead,
    .entry-tail {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .section li {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .entry-lead ~ .entry-bullets,
    .entry-tail .entry-bullets {
      margin-top: 0;
    }
    .project-item {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .section-atomic {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .section-lead,
    .section-tail {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    /* Sidebar list sections use .sidebar-section, not .section (Part 1 kept
       these separate namespaces) — .section-atomic/-lead/-tail above already
       apply regardless of the container class. Sidebar items still need
       their own atomicity rule (there is no .entry-atomic-equivalent class
       on them, and .section li doesn't reach .sidebar-section). */
    .sidebar-section .sidebar-item,
    .sidebar-section .sidebar-skill {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .entry-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }

    .entry-title {
      font-size: 10.5pt;
      font-weight: bold;
      color: var(--text);
    }

    .entry-dates {
      font-size: 8.5pt;
      color: var(--muted);
      white-space: nowrap;
    }

    .entry-subtitle {
      font-size: 9.5pt;
      color: var(--muted);
      margin-bottom: 3pt;
    }

    /* Quantified role facts (#328) — deterministic furniture, never prose */
    .entry-facts {
      font-size: 8.5pt;
      color: var(--muted);
      margin-bottom: 3pt;
    }

    .entry-bullets {
      padding-left: 12pt;
      list-style-type: disc;
      margin-top: 3pt;
    }

    .entry-bullets li {
      margin-bottom: 2pt;
      font-size: 9.5pt;
    }

    .entry-projects { margin-top: 5pt; }
    .entry-projects-title {
      font-size: 8.5pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--cv-primary);
      margin-bottom: 2pt;
    }
    .project-item { margin-bottom: 3pt; }
    .project-name { font-weight: 700; font-size: 9.5pt; }

    .summary-text {
      font-size: 10pt;
      line-height: 1.55;
    }

    /* #621 — .page carries no padding of its own here: the sidebar/main
       columns' OWN padding was doing double duty as both "gap between the two
       columns" and "the page's outer margin" (sidebar left 12mm + top 20mm +
       bottom 16mm; main right 18mm + top 20mm + bottom 16mm — outer edges,
       consistent between the two columns on every side they share). The
       uniform @page margin below is derived from those outer-facing values
       (top 20mm / right 18mm / bottom 16mm / left 12mm). Measured (minimal
       repro): a negative margin that reaches into the @page margin area is
       not painted there — so unlike the old margin:0 renderer, the sidebar's
       colour can no longer bleed to the paper edge under a real @page margin.
       Design point 3 accepts this ("a printable margin beats bleed") — see
       the report for before/after screenshots. Only the OUTER-facing padding
       (the leg that used to face the paper edge) is zeroed in print; the
       INNER-facing padding — sidebar's right / main's left, the visual gap
       between the two columns — is untouched. */
    @page {
      size: A4;
      margin: 20mm 18mm 16mm 12mm;
    }

    @media print {
      .page { width: auto; min-height: auto; margin: 0; }
      .sidebar { padding: 0 12mm 0 0; }
      .main { padding: 0 0 0 16mm; }
    }
  </style>
</head>
<body>
<div class="page">

  <aside class="sidebar">
    {% if cv.show_photo and cv.contact.photo_url %}
    <div class="sidebar-avatar">
      <img src="{{ cv.contact.photo_url }}" alt="Foto">
    </div>
    {% else %}
    <div class="sidebar-avatar-placeholder"></div>
    {% endif %}

    {# ADR-039: wrap each name token in a nowrap span so a hyphenated surname
       (e.g. "Müller-Lüdenscheidt") never breaks at the hyphen. A hyphen break
       inserts a stray space in the extracted PDF text ("Müller- Lüdenscheidt"),
       failing the contact-name extraction audit. The line still wraps between
       tokens, preserving the centred multi-line look. #}
    <div class="sidebar-name">{% for tok in cv.contact.name.split() %}<span style="white-space: nowrap;">{{ tok }}</span>{% if not loop.last %} {% endif %}{% endfor %}</div>

    <div class="sidebar-section">
      <div class="sidebar-section-title">{{ labels.contact }}</div>
      {% if cv.contact.location %}<div class="sidebar-item">{{ cv.contact.location }}</div>{% endif %}
      {% if cv.contact.phone %}<div class="sidebar-item">{{ cv.contact.phone }}</div>{% endif %}
      {% if cv.contact.email %}<div class="sidebar-item">{{ cv.contact.email }}</div>{% endif %}
      {% if cv.contact.linkedin %}<div class="sidebar-item">{{ cv.contact.linkedin }}</div>{% endif %}
    </div>

    {% if cv.skills %}
    {% set n_skills = cv.skills | length %}
    <div class="sidebar-section{{ ' section-atomic' if n_skills <= 6 else '' }}">
      {% if n_skills > 6 %}<div class="section-lead">{% endif %}
      <div class="sidebar-section-title">{{ labels.skills }}</div>
      {% for skill in cv.skills %}
      {% if n_skills > 6 and loop.index == 3 %}</div>{% endif %}
      {% if n_skills > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
      <div class="sidebar-skill">{{ skill }}</div>
      {% endfor %}
      {% if n_skills > 6 %}</div>{% endif %}
    </div>
    {% endif %}

    {% if cv.languages %}
    {% set n_langs = cv.languages | length %}
    <div class="sidebar-section{{ ' section-atomic' if n_langs <= 6 else '' }}">
      {% if n_langs > 6 %}<div class="section-lead">{% endif %}
      <div class="sidebar-section-title">{{ labels.languages }}</div>
      {% for lang in cv.languages %}
      {% if n_langs > 6 and loop.index == 3 %}</div>{% endif %}
      {% if n_langs > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
      <div class="sidebar-item">{{ lang.language }} · {{ lang.level }}</div>
      {% endfor %}
      {% if n_langs > 6 %}</div>{% endif %}
    </div>
    {% endif %}
  </aside>

  <main class="main">
    {% if cv.summary %}
    <div class="section">
      <div class="section-title">{{ labels.summary }}</div>
      <p class="summary-text">{{ cv.summary }}</p>
    </div>
    {% endif %}

    {% if cv.work_history %}
    <div class="section">
      <div class="section-title">{{ labels.experience }}</div>
      {% for job in cv.work_history %}
      {% set n_bullets = job.bullets | length %}
      <div class="entry{{ ' entry-atomic' if n_bullets <= 3 else '' }}">
        {% set head %}
        <div class="entry-header">
          <div class="entry-title">{{ job.role }}</div>
          <div class="entry-dates">{{ job.start_date | month_year }} – {{ job.end_date | month_year if job.end_date else labels.present }}</div>
        </div>
        <div class="entry-subtitle">{{ job.company }}</div>
        {% set role_facts = [] %}
        {% if job.team_size is not none %}{% set _ = role_facts.append(labels.role_team_size ~ ': ' ~ job.team_size) %}{% endif %}
        {% set budget_text = job.budget_managed | budget_display(lang) %}{% if budget_text %}{% set _ = role_facts.append(labels.role_budget ~ ': ' ~ budget_text) %}{% endif %}
        {% if job.industry_context %}{% set _ = role_facts.append(labels.role_industry ~ ': ' ~ job.industry_context) %}{% endif %}
        {% if role_facts %}
        <div class="entry-facts">{{ role_facts | join(' · ') }}</div>
        {% endif %}
        {% endset %}
        {% if n_bullets > 3 %}
        <div class="entry-lead">
          {{ head }}
          <ul class="entry-bullets">
            {% for bullet in job.bullets[:2] %}
            <li>{{ bullet }}</li>
            {% endfor %}
          </ul>
        </div>
        {% if n_bullets > 4 %}
        <ul class="entry-bullets">
          {% for bullet in job.bullets[2:-2] %}
          <li>{{ bullet }}</li>
          {% endfor %}
        </ul>
        {% endif %}
        <div class="entry-tail">
          <ul class="entry-bullets">
            {% for bullet in job.bullets[-2:] %}
            <li>{{ bullet }}</li>
            {% endfor %}
          </ul>
        </div>
        {% else %}
        {{ head }}
        {% if job.bullets %}
        <ul class="entry-bullets">
          {% for bullet in job.bullets %}
          <li>{{ bullet }}</li>
          {% endfor %}
        </ul>
        {% endif %}
        {% endif %}
        {% if job.projects %}
        <div class="entry-projects">
          <div class="entry-projects-title">{{ labels.projects }}</div>
          {% for project in job.projects %}
          <div class="project-item">
            <div class="project-name">{{ project.name }}</div>
            {% if project.bullets %}
            <ul class="entry-bullets">
              {% for bullet in project.bullets %}<li>{{ bullet }}</li>{% endfor %}
            </ul>
            {% endif %}
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if cv.projects %}
    <div class="section">
      <div class="section-title">{{ labels.projects }}</div>
      {% for project in cv.projects %}
      {% set n_bullets = project.bullets | length %}
      <div class="entry{{ ' entry-atomic' if n_bullets <= 3 else '' }}">
        {% if n_bullets > 3 %}
        <div class="entry-lead">
          <div class="entry-header">
            <div class="entry-title">{{ project.name }}</div>
          </div>
          <ul class="entry-bullets">
            {% for bullet in project.bullets[:2] %}<li>{{ bullet }}</li>{% endfor %}
          </ul>
        </div>
        {% if n_bullets > 4 %}
        <ul class="entry-bullets">
          {% for bullet in project.bullets[2:-2] %}<li>{{ bullet }}</li>{% endfor %}
        </ul>
        {% endif %}
        <div class="entry-tail">
          <ul class="entry-bullets">
            {% for bullet in project.bullets[-2:] %}<li>{{ bullet }}</li>{% endfor %}
          </ul>
        </div>
        {% else %}
        <div class="entry-header">
          <div class="entry-title">{{ project.name }}</div>
        </div>
        {% if project.bullets %}
        <ul class="entry-bullets">
          {% for bullet in project.bullets %}<li>{{ bullet }}</li>{% endfor %}
        </ul>
        {% endif %}
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if cv.education %}
    {% set n_edu = cv.education | length %}
    <div class="section{{ ' section-atomic' if n_edu <= 6 else '' }}">
      {% if n_edu > 6 %}<div class="section-lead">{% endif %}
      <div class="section-title">{{ labels.education }}</div>
      {% for edu in cv.education %}
      {% if n_edu > 6 and loop.index == 3 %}</div>{% endif %}
      {% if n_edu > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
      <div class="entry entry-atomic">
        <div class="entry-header">
          <div class="entry-title">{{ edu.degree | education_title(edu.field) }}</div>
          <div class="entry-dates">{{ edu.start_date | month_year }}{% if edu.start_date %} – {% endif %}{{ edu.end_date | month_year if edu.end_date else (labels.present if edu.start_date else "") }}</div>
        </div>
        <div class="entry-subtitle">{{ edu.institution }}</div>
      </div>
      {% endfor %}
      {% if n_edu > 6 %}</div>{% endif %}
    </div>
    {% endif %}

    {% if cv.certifications %}
    {% set n_certs = cv.certifications | length %}
    <div class="section{{ ' section-atomic' if n_certs <= 6 else '' }}">
      {% if n_certs > 6 %}<div class="section-lead">{% endif %}
      <div class="section-title">{{ labels.certifications }}</div>
      {% for cert in cv.certifications %}
      {% if n_certs > 6 and loop.index == 3 %}</div>{% endif %}
      {% if n_certs > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
      <div class="entry entry-atomic">
        <div class="entry-header">
          <div class="entry-title">{{ cert.name }}</div>
          <div class="entry-dates">{{ cert.date_obtained | month_year }}</div>
        </div>
        {% if cert.issuing_organization %}<div class="entry-subtitle">{{ cert.issuing_organization }}</div>{% endif %}
      </div>
      {% endfor %}
      {% if n_certs > 6 %}</div>{% endif %}
    </div>
    {% endif %}
  </main>

</div>
</body>
</html>
