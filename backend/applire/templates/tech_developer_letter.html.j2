<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8"/>
  <title>{{ labels.document_title }} – {{ letter.header.name }}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --primary: {{ color.primary }}; --surface: {{ color.surface }}; --surface-text: {{ color.surface_text }}; }
    body { font-family: "Segoe UI", system-ui, sans-serif; font-size: 10pt; line-height: 1.6; color: #e2e8f0; background: #0d1117; /* = the CV twin's page colour; var(--surface) equals --primary in every colour profile (surface = primary), which made the accent-coloured name and strip invisible */ }
    .page { width: 210mm; min-height: 297mm; margin: 0 auto; padding: 20mm 22mm 20mm 25mm; }
    /* Header = the CV twin's header (tech_developer.html.j2): 3pt accent strip on top, then
       mono name in the accent colour with the muted contact lines stacked right-aligned,
       closed by a 1px #30363d rule. */
    .accent-strip { height: 3pt; background: var(--primary); margin-bottom: 16pt; border-radius: 1pt; }
    .header { border-bottom: 1px solid #30363d; padding-bottom: 12pt; margin-bottom: 8mm; display: flex; justify-content: space-between; align-items: flex-end; line-height: 1.55; }
    .header-name { font-family: "Courier New", Courier, monospace; font-size: 20pt; font-weight: bold; color: var(--primary); letter-spacing: -0.01em; }
    .header-contact { text-align: right; font-family: "Courier New", Courier, monospace; font-size: 8.5pt; color: #8b949e; line-height: 1.8; }
    .recipient { margin-bottom: 8mm; font-size: 10pt; color: #cbd5e1; }
    .date { text-align: right; margin-bottom: 6mm; color: #94a3b8; font-size: 9pt; font-family: "Courier New", monospace; }
    .subject { font-weight: 700; font-size: 11pt; margin-bottom: 7mm; color: var(--primary); }
    .body p { margin-bottom: 5mm; color: #e2e8f0; }
    /* #547: break-inside:avoid pushes the WHOLE block to page 2 once it no
       longer fits the remainder of page 1, orphaning it alone with the
       freed space still visible on page 1 — 4mm less air shrinks the
       atomic unit so it fits the remainder more often (see academic_letter
       for the full rationale; same fix, N templates — ADR-066). */
    .signature { break-inside: avoid; page-break-inside: avoid; margin-top: 6mm; color: #cbd5e1; }
    .signature .closing { margin-bottom: 8mm; }
    .signature-image { display: block; height: 14mm; width: auto; max-width: 60mm; margin: 0 0 1mm; }
    .signature.has-signature .closing { margin-bottom: 2mm; }
    /* #621 — the visual margin now lives in @page (Chromium's paged-media
       engine re-applies it on every page); .page's own padding/size, which
       used to BE the margin on the print path, is neutralised in print so it
       doesn't double up with @page. Kept for the on-screen HTML preview
       above (width/min-height/padding), which never goes through @page. */
    @page {
      size: A4;
      margin: 20mm 22mm 20mm 25mm;
    }
    @media print {
      body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .page { padding: 0; width: auto; min-height: auto; margin: 0; }
    }
  </style>
</head>
<body>
<div class="page">
  <div class="accent-strip"></div>
  <div class="header">
    <div class="header-name">{{ letter.header.name }}</div>
    <div class="header-contact">
      {% if letter.header.address %}<div>{{ letter.header.address }}</div>{% endif %}
      {% if letter.header.email %}<div>{{ letter.header.email }}</div>{% endif %}
      {% if letter.header.phone %}<div>{{ letter.header.phone }}</div>{% endif %}
    </div>
  </div>
  <div class="recipient">{% if letter.recipient.name %}{{ letter.recipient.name }}<br>{% endif %}{% if letter.recipient.company %}{{ letter.recipient.company }}<br>{% endif %}{% if letter.recipient.address %}{{ letter.recipient.address }}{% endif %}</div>
  <div class="date">{{ letter.recipient.date }}</div>
  <div class="subject">{{ subject }}{% if letter.recipient.company %} — {{ letter.recipient.company }}{% endif %}</div>
  <div class="body">{% for para in letter.body.paragraphs %}<p>{{ para }}</p>{% endfor %}</div>
  <div class="signature{% if signature_image %} has-signature{% endif %}"><div class="closing">{{ letter.signature.closing }}{{ labels.closing_punctuation }}</div>{% if signature_image %}<img class="signature-image" src="{{ signature_image }}" alt="">{% endif %}<div>{{ letter.signature.name }}</div></div>
</div>
</body>
</html>
