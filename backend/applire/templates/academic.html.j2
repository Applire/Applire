<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8" />
  <title>{{ labels.document_title }} – {{ cv.contact.name }}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cv-primary: {{ color.primary }};
      --cv-primary-tint: {{ color.primary_tint }};
      --text: #111;
      --muted: #444;
      --rule: #bbb;
    }

    body {
      font-family: "Times New Roman", Times, serif;
      font-size: 11pt;
      line-height: 1.5;
      color: var(--text);
      background: #fff;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      padding: 22mm 22mm 20mm 22mm;
    }

    .header {
      text-align: center;
      border-bottom: 1.5px solid var(--cv-primary);
      padding-bottom: 10pt;
      margin-bottom: 16pt;
    }

    .header h1 {
      font-size: 18pt;
      font-weight: bold;
      letter-spacing: 0.03em;
      margin-bottom: 4pt;
    }

    .header-sub {
      font-size: 9.5pt;
      color: var(--muted);
      line-height: 1.8;
    }

    .section { margin-bottom: 14pt; }

    .section-title {
      font-size: 10.5pt;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--cv-primary);
      border-bottom: 1px solid var(--rule);
      padding-bottom: 2pt;
      margin-bottom: 8pt;
      /* #357 — a section heading never orphans at the foot of a page. */
      break-after: avoid;
      page-break-after: avoid;
    }

    .entry {
      display: grid;
      grid-template-columns: 28mm 1fr;
      gap: 0 8pt;
      margin-bottom: 8pt;
      /* #357/#622 — a SHORT entry (<=3 bullets, class .entry-atomic below)
         stays one unit. A LONG entry (>3 bullets) may now break. */
    }

    /* #622 — break policy. SHORT entries (<=3 bullets, and every education/
       certification entry, which never carries bullets) stay atomic, same as
       #357. LONG entries (>3 bullets) may break, but the head (title/company/
       dates) + first 2 bullets is one keep-together group (.entry-lead), the
       last 2 bullets are another (.entry-tail), and every remaining bullet is
       itself atomic (.section li) — never mid-sentence. List sections
       (certifications/education/...) follow the same shape at the item
       level via .section-atomic/.section-lead/.section-tail below, so a
       heading or a single stranded item never sits alone at a page foot. */
    .entry-atomic {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .entry-lead,
    .entry-tail {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .section li {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .entry-lead ~ .entry-bullets,
    .entry-tail .entry-bullets {
      margin-top: 0;
    }
    /* D-35: a SHORT project (<=3 bullets) stays one unit; a LONG one keeps its
       name + first 2 bullets together (.project-lead) and may break after. */
    .project-atomic,
    .project-lead {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .project-lead ~ .entry-bullets { margin-top: 0; }
    /* D-35: the nested projects never open a page without their role — the
       block before them (the role's lead or tail) travels with their first block. */
    .entry-projects {
      break-before: avoid;
      page-break-before: avoid;
    }
    /* D-35: when projects follow, a long role's last 2 bullets are no longer one
       unit — only the LAST bullet travels with the projects, so the break costs
       one bullet's height, not two. */
    .entry-tail.entry-tail-open {
      break-inside: auto;
      page-break-inside: auto;
    }
    .section-atomic {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .section-lead,
    .section-tail {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .entry-date {
      font-size: 9.5pt;
      color: var(--muted);
      padding-top: 1pt;
      text-align: right;
    }

    .entry-content { }

    .entry-title {
      font-size: 10.5pt;
      font-weight: bold;
    }

    .entry-subtitle {
      font-size: 9.5pt;
      color: var(--muted);
      margin-bottom: 2pt;
    }

    /* Quantified role facts (#328) — deterministic furniture, never prose */
    .entry-facts {
      font-size: 9pt;
      color: var(--muted);
      margin-bottom: 2pt;
      font-style: italic;
    }

    .entry-bullets {
      padding-left: 12pt;
      list-style-type: disc;
      margin-top: 2pt;
    }

    .entry-bullets li {
      margin-bottom: 1.5pt;
      font-size: 10pt;
    }

    .entry-projects { margin-top: 4pt; }
    .entry-projects-title {
      /* D-6 (delivery run 4): the sub-label moves with its first project — never alone at a page foot. */
      break-after: avoid;
      page-break-after: avoid;
      font-size: 9pt;
      font-weight: bold;
      font-style: italic;
      color: var(--cv-primary);
      margin-bottom: 2pt;
    }
    .project-item { margin-bottom: 3pt; }
    .project-name { font-weight: bold; font-size: 10pt; }

    .skill-block { font-size: 10pt; line-height: 1.7; }

    .lang-table {
      display: grid;
      grid-template-columns: max-content 1fr;
      gap: 3pt 16pt;
      font-size: 10pt;
    }
    .lang-name { font-weight: 600; }
    .lang-level { color: var(--muted); }

    .summary-text { font-size: 11pt; line-height: 1.55; }

    /* Signature (#F frontend, Nougat build 2) */
    .signature-block { break-inside: avoid; page-break-inside: avoid; margin-top: 8mm; }
    .signature-block .signature-place-date { margin-bottom: 2mm; }
    .signature-block .signature-image { display: block; height: 14mm; width: auto; max-width: 60mm; }

    /* #621 — the visual margin now lives in @page (Chromium's paged-media
       engine re-applies it on every page); .page's own padding/size, which
       used to BE the margin on the print path, is neutralised in print so it
       doesn't double up with @page. Kept for the on-screen HTML preview
       above (width/min-height/padding), which never goes through @page. */
    @page {
      size: A4;
      margin: 22mm 22mm 20mm 22mm;
    }

    @media print {
      body { background: #fff; }
      .page { padding: 0; width: auto; min-height: auto; margin: 0; }
    }
  </style>
</head>
<body>
<div class="page">

  <header class="header">
    <h1>{{ cv.contact.name }}</h1>
    <div class="header-sub">
      {% if cv.contact.location %}<span>{{ cv.contact.location }}</span>{% endif %}
      {% if cv.contact.email %} &nbsp;·&nbsp; <span>{{ cv.contact.email }}</span>{% endif %}
      {% if cv.contact.phone %} &nbsp;·&nbsp; <span>{{ cv.contact.phone }}</span>{% endif %}
      {% if cv.contact.linkedin %}<br/><span>{{ cv.contact.linkedin }}</span>{% endif %}
    </div>
  </header>

  {% if cv.summary %}
  <div class="section">
    <div class="section-title">{{ labels.summary }}</div>
    <p class="summary-text">{{ cv.summary }}</p>
  </div>
  {% endif %}

  {% if cv.work_history %}
  <div class="section">
    <div class="section-title">{{ labels.experience }}</div>
    {% for job in cv.work_history %}
    {% set n_bullets = job.bullets | length %}
    {# D-35: an entry is atomic only when ALL of it is short — its own bullets
       PLUS its nested projects' bullets (a 2-bullet role with a 5-bullet project
       was one unbreakable block and left page 1 ~40 % empty). #}
    {% set n_proj_bullets = job.projects | map(attribute='bullets') | map('length') | sum %}
    <div class="entry{{ ' entry-atomic' if n_bullets + n_proj_bullets <= 3 else '' }}">
      <div class="entry-date">{% set job_period = job | period(labels.present) %}{{ job_period.start }}{% if job_period.dash %}<br/>– {% endif %}{{ job_period.end }}</div>
      <div class="entry-content">
        {% set head %}
        <div class="entry-title">{{ job.role }}</div>
        <div class="entry-subtitle">{{ job.company }}</div>
        {# Founder ruling P-1: one fact line, numbers only, no labels, no industry
           (filters.role_facts — shared with the .docx export). #}
        {% set role_facts_text = job | role_facts(lang) %}
        {% if role_facts_text %}
        <div class="entry-facts">{{ role_facts_text }}</div>
        {% endif %}
        {% endset %}
        {% if n_bullets > 3 %}
        <div class="entry-lead">
          {{ head }}
          <ul class="entry-bullets">
            {% for bullet in job.bullets[:2] %}<li>{{ bullet }}</li>{% endfor %}
          </ul>
        </div>
        {% if n_bullets > 4 %}
        <ul class="entry-bullets">
          {% for bullet in job.bullets[2:-2] %}<li>{{ bullet }}</li>{% endfor %}
        </ul>
        {% endif %}
        <div class="entry-tail{{ ' entry-tail-open' if job.projects else '' }}">
          <ul class="entry-bullets">
            {% for bullet in job.bullets[-2:] %}<li>{{ bullet }}</li>{% endfor %}
          </ul>
        </div>
        {% else %}
        {% if job.projects and n_bullets + n_proj_bullets > 3 %}
        {# D-35: a short role WITH nested projects breaks like a long one — head +
           first 2 own bullets keep together (.entry-lead), the rest follow, and the
           projects travel with the block before them (.entry-projects
           break-before: avoid): they never open a page on their own. #}
        <div class="entry-lead">
          {{ head }}
          {% if job.bullets %}<ul class="entry-bullets">{% for bullet in job.bullets[:2] %}<li>{{ bullet }}</li>{% endfor %}</ul>{% endif %}
        </div>
        {% if n_bullets > 2 %}<ul class="entry-bullets">{% for bullet in job.bullets[2:] %}<li>{{ bullet }}</li>{% endfor %}</ul>{% endif %}
        {% else %}
        {{ head }}
        {% if job.bullets %}
        <ul class="entry-bullets">
          {% for bullet in job.bullets %}<li>{{ bullet }}</li>{% endfor %}
        </ul>
        {% endif %}
        {% endif %}
        {% endif %}
        {% if job.projects %}
        <div class="entry-projects">
          <div class="entry-projects-title">{{ labels.projects }}</div>
          {% for project in job.projects %}
          {% set n_pb = project.bullets | length %}
          <div class="project-item{{ ' project-atomic' if n_pb <= 1 else '' }}">
            {% if n_pb > 1 %}
            {# D-35: a project with more than one bullet may break — its name + first bullet keep together. #}
            <div class="project-lead">
              <div class="project-name">{{ project.name }}</div>
              <ul class="entry-bullets">{% for bullet in project.bullets[:1] %}<li>{{ bullet }}</li>{% endfor %}</ul>
            </div>
            <ul class="entry-bullets">{% for bullet in project.bullets[1:] %}<li>{{ bullet }}</li>{% endfor %}</ul>
            {% else %}
            <div class="project-name">{{ project.name }}</div>
            {% if project.bullets %}
            <ul class="entry-bullets">{% for bullet in project.bullets %}<li>{{ bullet }}</li>{% endfor %}</ul>
            {% endif %}
            {% endif %}
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if cv.projects %}
  <div class="section">
    <div class="section-title">{{ labels.projects }}</div>
    {% for project in cv.projects %}
    {% set n_bullets = project.bullets | length %}
    <div class="entry{{ ' entry-atomic' if n_bullets <= 3 else '' }}">
      <div class="entry-date"></div>
      <div class="entry-content">
        {% if n_bullets > 3 %}
        <div class="entry-lead">
          <div class="entry-title">{{ project.name }}</div>
          <ul class="entry-bullets">
            {% for bullet in project.bullets[:2] %}<li>{{ bullet }}</li>{% endfor %}
          </ul>
        </div>
        {% if n_bullets > 4 %}
        <ul class="entry-bullets">
          {% for bullet in project.bullets[2:-2] %}<li>{{ bullet }}</li>{% endfor %}
        </ul>
        {% endif %}
        <div class="entry-tail">
          <ul class="entry-bullets">
            {% for bullet in project.bullets[-2:] %}<li>{{ bullet }}</li>{% endfor %}
          </ul>
        </div>
        {% else %}
        <div class="entry-title">{{ project.name }}</div>
        {% if project.bullets %}
        <ul class="entry-bullets">
          {% for bullet in project.bullets %}<li>{{ bullet }}</li>{% endfor %}
        </ul>
        {% endif %}
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if cv.education %}
  {% set n_edu = cv.education | length %}
  <div class="section{{ ' section-atomic' if n_edu <= 6 else '' }}">
    {% if n_edu > 6 %}<div class="section-lead">{% endif %}
    <div class="section-title">{{ labels.education }}</div>
    {% for edu in cv.education %}
    {% if n_edu > 6 and loop.index == 3 %}</div>{% endif %}
    {% if n_edu > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
    <div class="entry entry-atomic">
      <div class="entry-date">{% set edu_period = edu | period(labels.present) %}{{ edu_period.start }}{% if edu_period.dash %}<br/>– {% endif %}{{ edu_period.end }}</div>
      <div class="entry-content">
        <div class="entry-title">{{ edu.degree | education_title(edu.field) }}</div>
        <div class="entry-subtitle">{{ edu.institution }}</div>
      </div>
    </div>
    {% endfor %}
    {% if n_edu > 6 %}</div>{% endif %}
  </div>
  {% endif %}

  {% if cv.certifications %}
  {% set n_certs = cv.certifications | length %}
  <div class="section{{ ' section-atomic' if n_certs <= 6 else '' }}">
    {% if n_certs > 6 %}<div class="section-lead">{% endif %}
    <div class="section-title">{{ labels.certifications }}</div>
    {% for cert in cv.certifications %}
    {% if n_certs > 6 and loop.index == 3 %}</div>{% endif %}
    {% if n_certs > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
    <div class="entry entry-atomic">
      <div class="entry-date">{{ cert.date_obtained | month_year }}</div>
      <div class="entry-content">
        <div class="entry-title">{{ cert.name }}</div>
        {% if cert.issuing_organization %}<div class="entry-subtitle">{{ cert.issuing_organization }}</div>{% endif %}
      </div>
    </div>
    {% endfor %}
    {% if n_certs > 6 %}</div>{% endif %}
  </div>
  {% endif %}

  {# #622 scope note: skills is a single joined text blob here (no per-item
     element to split), languages is a bare span-pair grid (same issue) — both
     fall back to whole-section atomicity for any item count. See the report. #}
  {% if cv.skills %}
  <div class="section section-atomic">
    <div class="section-title">{{ labels.skills }}</div>
    <div class="skill-block">{{ cv.skills | join(" · ") }}</div>
  </div>
  {% endif %}

  {% if cv.languages %}
  <div class="section section-atomic">
    <div class="section-title">{{ labels.languages }}</div>
    <div class="lang-table">
      {% for lang in cv.languages %}
      <span class="lang-name">{{ lang.language }}</span>
      <span class="lang-level">{{ lang.level }}</span>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if signature_image %}
  <div class="signature-block">
    {% if signature_place_date %}<div class="signature-place-date">{{ signature_place_date }}</div>{% endif %}
    <img class="signature-image" src="{{ signature_image }}" alt="">
  </div>
  {% endif %}

</div>
</body>
</html>
