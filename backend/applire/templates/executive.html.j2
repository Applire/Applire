<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8" />
  <title>Lebenslauf – {{ cv.contact.name }}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cv-primary: {{ color.primary }};
      --cv-primary-tint: {{ color.primary_tint }};
      --cv-surface: {{ color.surface }};
      --cv-surface-text: {{ color.surface_text }};
      --text: #1a1a2e;
      --muted: #4a4a5a;
      --rule: #d8d8e0;
    }

    body {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 10.5pt;
      line-height: 1.5;
      color: var(--text);
      background: #fff;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
    }

    .header {
      background: var(--cv-surface);
      color: var(--cv-surface-text);
      padding: 18mm 20mm 14mm 20mm;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16pt;
    }

    .header-name h1 {
      font-size: 24pt;
      font-weight: bold;
      letter-spacing: 0.04em;
      color: var(--cv-surface-text);
      margin-bottom: 4pt;
    }

    .header-title {
      font-size: 11pt;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--cv-surface-text);
      opacity: 0.75;
    }

    .header-contact {
      text-align: right;
      font-size: 9pt;
      color: var(--cv-surface-text);
      opacity: 0.85;
      line-height: 1.8;
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    }

    .header-avatar {
      flex-shrink: 0;
      width: 32mm;
      height: 32mm;
      border-radius: 50%;
      overflow: hidden;
      border: 2px solid rgba(255,255,255,0.3);
    }
    .header-avatar img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }

    .body {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 0;
      padding: 14mm 20mm 16mm 20mm;
    }

    .col-left { padding-right: 14pt; border-right: 1px solid var(--rule); }
    .col-right { padding-left: 14pt; }

    .section { margin-bottom: 14pt; }

    .section-title {
      font-size: 8pt;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--cv-primary);
      border-bottom: 1.5px solid var(--cv-primary);
      padding-bottom: 2pt;
      margin-bottom: 8pt;
      /* #357 — a section heading never orphans at the foot of a page. */
      break-after: avoid;
      page-break-after: avoid;
    }

    .entry {
      margin-bottom: 9pt;
      /* #357/#622 — a SHORT entry (<=3 bullets, class .entry-atomic below)
         stays one unit. A LONG entry (>3 bullets) may now break. */
    }

    /* #622 — break policy. SHORT entries (<=3 bullets, and every education/
       certification entry, which never carries bullets) stay atomic, same as
       #357. LONG entries (>3 bullets) may break, but the head (title/company/
       dates) + first 2 bullets is one keep-together group (.entry-lead), the
       last 2 bullets are another (.entry-tail), and every remaining bullet is
       itself atomic (.section li) — never mid-sentence. List sections
       (certifications/education/...) follow the same shape at the item
       level via .section-atomic/.section-lead/.section-tail below, so a
       heading or a single stranded item never sits alone at a page foot. */
    .entry-atomic {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .entry-lead,
    .entry-tail {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .section li {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .entry-lead ~ .entry-bullets,
    .entry-tail .entry-bullets {
      margin-top: 0;
    }
    .project-item {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .section-atomic {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .section-lead,
    .section-tail {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    /* List-section items here are bare divs (.skill-item, .lang-row), not
       .entry — they need their own atomicity rule directly. */
    .skill-item,
    .lang-row {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .entry-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }

    .entry-title {
      font-size: 10.5pt;
      font-weight: bold;
      color: var(--text);
    }

    .entry-dates {
      font-size: 8.5pt;
      color: var(--muted);
      white-space: nowrap;
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    }

    .entry-subtitle {
      font-size: 9.5pt;
      color: var(--muted);
      margin-bottom: 3pt;
    }

    /* Quantified role facts (#328) — deterministic furniture, never prose */
    .entry-facts {
      font-size: 8.5pt;
      color: var(--muted);
      margin-bottom: 3pt;
    }

    .entry-bullets {
      padding-left: 12pt;
      list-style-type: disc;
      margin-top: 3pt;
    }

    .entry-projects { margin-top: 5pt; }
    .entry-projects-title {
      font-size: 9pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--cv-primary);
      margin-bottom: 2pt;
    }
    .project-item { margin-bottom: 3pt; }
    .project-name { font-weight: 700; font-size: 10.5pt; }

    .entry-bullets li {
      margin-bottom: 1.5pt;
      font-size: 9.5pt;
    }

    .skill-item {
      font-size: 9.5pt;
      padding: 2pt 0;
      color: var(--text);
      border-bottom: 1px dotted var(--rule);
    }

    .lang-row {
      display: flex;
      justify-content: space-between;
      font-size: 9.5pt;
      padding: 2pt 0;
      border-bottom: 1px dotted var(--rule);
    }
    .lang-name { font-weight: 600; }
    .lang-level { color: var(--muted); }

    .summary-text {
      font-size: 10.5pt;
      line-height: 1.55;
      color: var(--text);
    }

    /* #621 — .page carries no padding of its own here: the coloured .header
       band's own top/left/right padding (18mm/20mm/20mm) was doing double
       duty as both the band's internal text inset AND the page's outer
       margin (the band sits flush at the paper edge with nothing else
       providing an outer margin); .header's bottom padding (14mm) is
       unrelated — it is the gap AFTER the band, before .body, and is kept.
       Likewise .body's own left/right padding (20mm/20mm) doubles as the
       page's side margin for every page after the header, and its bottom
       padding (16mm) is the page's bottom margin; .body's top padding
       (14mm) is unrelated (the gap after the band on page 1) and is kept.
       The uniform @page margin below is derived from those outer-facing
       values (top 18mm from .header / right+left 20mm, consistent between
       .header and .body / bottom 16mm from .body). Measured (minimal
       repro): a negative margin that reaches into the @page margin area is
       not painted there — so unlike the old margin:0 renderer, the header
       band can no longer bleed to the paper edge under a real @page margin.
       Design point 3 accepts this ("a printable margin beats bleed") — see
       the report for before/after screenshots. */
    @page {
      size: A4;
      margin: 18mm 20mm 16mm 20mm;
    }

    @media print {
      .page { width: auto; min-height: auto; margin: 0; }
      .header { padding: 0 0 14mm 0; }
      .body { padding: 14mm 0 0 0; }
    }
  </style>
</head>
<body>
<div class="page">

  <header class="header">
    <div class="header-inner">
      <div>
        <div class="header-name"><h1>{{ cv.contact.name }}</h1></div>
        {% if cv.work_history %}<div class="header-title">{{ cv.work_history[0].role }}</div>{% endif %}
      </div>
      <div style="display:flex;align-items:flex-start;gap:14pt;">
        <div class="header-contact">
          {% if cv.contact.location %}<div>{{ cv.contact.location }}</div>{% endif %}
          {% if cv.contact.phone %}<div>{{ cv.contact.phone }}</div>{% endif %}
          {% if cv.contact.email %}<div>{{ cv.contact.email }}</div>{% endif %}
          {% if cv.contact.linkedin %}<div>{{ cv.contact.linkedin }}</div>{% endif %}
        </div>
        {% if cv.show_photo and cv.contact.photo_url %}
        <div class="header-avatar">
          <img src="{{ cv.contact.photo_url }}" alt="Foto">
        </div>
        {% endif %}
      </div>
    </div>
  </header>

  <div class="body">
    <div class="col-left">
      {% if cv.skills %}
      {% set n_skills = cv.skills | length %}
      <div class="section{{ ' section-atomic' if n_skills <= 6 else '' }}">
        {% if n_skills > 6 %}<div class="section-lead">{% endif %}
        <div class="section-title">{{ labels.skills }}</div>
        {% for skill in cv.skills %}
        {% if n_skills > 6 and loop.index == 3 %}</div>{% endif %}
        {% if n_skills > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
        <div class="skill-item">{{ skill }}</div>
        {% endfor %}
        {% if n_skills > 6 %}</div>{% endif %}
      </div>
      {% endif %}

      {% if cv.education %}
      {% set n_edu = cv.education | length %}
      <div class="section{{ ' section-atomic' if n_edu <= 6 else '' }}">
        {% if n_edu > 6 %}<div class="section-lead">{% endif %}
        <div class="section-title">{{ labels.education }}</div>
        {% for edu in cv.education %}
        {% if n_edu > 6 and loop.index == 3 %}</div>{% endif %}
        {% if n_edu > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
        <div class="entry entry-atomic">
          <div class="entry-title">{{ edu.degree | education_title(edu.field) }}</div>
          <div class="entry-subtitle">{{ edu.institution }}</div>
          <div class="entry-dates">{{ edu.start_date | month_year }}{% if edu.start_date %} – {% endif %}{{ edu.end_date | month_year if edu.end_date else (labels.present if edu.start_date else "") }}</div>
        </div>
        {% endfor %}
        {% if n_edu > 6 %}</div>{% endif %}
      </div>
      {% endif %}

      {% if cv.certifications %}
      {% set n_certs = cv.certifications | length %}
      <div class="section{{ ' section-atomic' if n_certs <= 6 else '' }}">
        {% if n_certs > 6 %}<div class="section-lead">{% endif %}
        <div class="section-title">{{ labels.certifications }}</div>
        {% for cert in cv.certifications %}
        {% if n_certs > 6 and loop.index == 3 %}</div>{% endif %}
        {% if n_certs > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
        <div class="entry entry-atomic">
          <div class="entry-title">{{ cert.name }}</div>
          {% if cert.issuing_organization %}<div class="entry-subtitle">{{ cert.issuing_organization }}</div>{% endif %}
          <div class="entry-dates">{{ cert.date_obtained | month_year }}</div>
        </div>
        {% endfor %}
        {% if n_certs > 6 %}</div>{% endif %}
      </div>
      {% endif %}

      {% if cv.languages %}
      {% set n_langs = cv.languages | length %}
      <div class="section{{ ' section-atomic' if n_langs <= 6 else '' }}">
        {% if n_langs > 6 %}<div class="section-lead">{% endif %}
        <div class="section-title">{{ labels.languages }}</div>
        {% for lang in cv.languages %}
        {% if n_langs > 6 and loop.index == 3 %}</div>{% endif %}
        {% if n_langs > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
        <div class="lang-row">
          <span class="lang-name">{{ lang.language }}</span>
          <span class="lang-level">{{ lang.level }}</span>
        </div>
        {% endfor %}
        {% if n_langs > 6 %}</div>{% endif %}
      </div>
      {% endif %}
    </div>

    <div class="col-right">
      {% if cv.summary %}
      <div class="section">
        <div class="section-title">{{ labels.summary }}</div>
        <p class="summary-text">{{ cv.summary }}</p>
      </div>
      {% endif %}

      {% if cv.work_history %}
      <div class="section">
        <div class="section-title">{{ labels.experience }}</div>
        {% for job in cv.work_history %}
        {% set n_bullets = job.bullets | length %}
        <div class="entry{{ ' entry-atomic' if n_bullets <= 3 else '' }}">
          {% set head %}
          <div class="entry-header">
            <div class="entry-title">{{ job.role }}</div>
            <div class="entry-dates">{{ job.start_date | month_year }} – {{ job.end_date | month_year if job.end_date else labels.present }}</div>
          </div>
          <div class="entry-subtitle">{{ job.company }}</div>
          {% set role_facts = [] %}
          {% if job.team_size is not none %}{% set _ = role_facts.append(labels.role_team_size ~ ': ' ~ job.team_size) %}{% endif %}
          {% set budget_text = job.budget_managed | budget_display(lang) %}{% if budget_text %}{% set _ = role_facts.append(labels.role_budget ~ ': ' ~ budget_text) %}{% endif %}
          {% if job.industry_context %}{% set _ = role_facts.append(labels.role_industry ~ ': ' ~ job.industry_context) %}{% endif %}
          {% if role_facts %}
          <div class="entry-facts">{{ role_facts | join(' · ') }}</div>
          {% endif %}
          {% endset %}
          {% if n_bullets > 3 %}
          <div class="entry-lead">
            {{ head }}
            <ul class="entry-bullets">
              {% for bullet in job.bullets[:2] %}
              <li>{{ bullet }}</li>
              {% endfor %}
            </ul>
          </div>
          {% if n_bullets > 4 %}
          <ul class="entry-bullets">
            {% for bullet in job.bullets[2:-2] %}
            <li>{{ bullet }}</li>
            {% endfor %}
          </ul>
          {% endif %}
          <div class="entry-tail">
            <ul class="entry-bullets">
              {% for bullet in job.bullets[-2:] %}
              <li>{{ bullet }}</li>
              {% endfor %}
            </ul>
          </div>
          {% else %}
          {{ head }}
          {% if job.bullets %}
          <ul class="entry-bullets">
            {% for bullet in job.bullets %}
            <li>{{ bullet }}</li>
            {% endfor %}
          </ul>
          {% endif %}
          {% endif %}
          {% if job.projects %}
          <div class="entry-projects">
            <div class="entry-projects-title">{{ labels.projects }}</div>
            {% for project in job.projects %}
            <div class="project-item">
              <div class="project-name">{{ project.name }}</div>
              {% if project.bullets %}
              <ul class="entry-bullets">
                {% for bullet in project.bullets %}<li>{{ bullet }}</li>{% endfor %}
              </ul>
              {% endif %}
            </div>
            {% endfor %}
          </div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% if cv.projects %}
      <div class="section">
        <div class="section-title">{{ labels.projects }}</div>
        {% for project in cv.projects %}
        {% set n_bullets = project.bullets | length %}
        <div class="entry{{ ' entry-atomic' if n_bullets <= 3 else '' }}">
          {% if n_bullets > 3 %}
          <div class="entry-lead">
            <div class="entry-header">
              <div class="entry-title">{{ project.name }}</div>
            </div>
            <ul class="entry-bullets">
              {% for bullet in project.bullets[:2] %}<li>{{ bullet }}</li>{% endfor %}
            </ul>
          </div>
          {% if n_bullets > 4 %}
          <ul class="entry-bullets">
            {% for bullet in project.bullets[2:-2] %}<li>{{ bullet }}</li>{% endfor %}
          </ul>
          {% endif %}
          <div class="entry-tail">
            <ul class="entry-bullets">
              {% for bullet in project.bullets[-2:] %}<li>{{ bullet }}</li>{% endfor %}
            </ul>
          </div>
          {% else %}
          <div class="entry-header">
            <div class="entry-title">{{ project.name }}</div>
          </div>
          {% if project.bullets %}
          <ul class="entry-bullets">
            {% for bullet in project.bullets %}<li>{{ bullet }}</li>{% endfor %}
          </ul>
          {% endif %}
          {% endif %}
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </div>

</div>
</body>
</html>
