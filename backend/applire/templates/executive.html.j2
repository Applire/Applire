<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8" />
  <title>{{ labels.document_title }} – {{ cv.contact.name }}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cv-primary: {{ color.primary }};
      --cv-primary-tint: {{ color.primary_tint }};
      --cv-surface: {{ color.surface }};
      --cv-surface-text: {{ color.surface_text }};
      --text: #1a1a2e;
      --muted: #4a4a5a;
      --rule: #d8d8e0;
    }

    body {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 10.5pt;
      line-height: 1.5;
      color: var(--text);
      background: #fff;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
    }

    .header {
      background: var(--cv-surface);
      color: var(--cv-surface-text);
      padding: 18mm 20mm 14mm 20mm;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16pt;
    }

    .header-name h1 {
      font-size: 24pt;
      font-weight: bold;
      letter-spacing: 0.04em;
      color: var(--cv-surface-text);
      margin-bottom: 4pt;
    }

    .header-title {
      font-size: 11pt;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--cv-surface-text);
      opacity: 0.75;
    }

    .header-contact {
      text-align: right;
      font-size: 9pt;
      color: var(--cv-surface-text);
      opacity: 0.85;
      line-height: 1.8;
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    }

    .header-avatar {
      flex-shrink: 0;
      width: 32mm;
      height: 32mm;
      border-radius: 50%;
      overflow: hidden;
      border: 2px solid rgba(255,255,255,0.3);
    }
    .header-avatar img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }

    .body {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 0;
      padding: 14mm 20mm 16mm 20mm;
    }

    .col-left { padding-right: 14pt; border-right: 1px solid var(--rule); }
    .col-right { padding-left: 14pt; }

    .section { margin-bottom: 14pt; }

    .section-title {
      font-size: 8pt;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--cv-primary);
      border-bottom: 1.5px solid var(--cv-primary);
      padding-bottom: 2pt;
      margin-bottom: 8pt;
      /* #357 — a section heading never orphans at the foot of a page. */
      break-after: avoid;
      page-break-after: avoid;
    }

    .entry {
      margin-bottom: 9pt;
      /* #357/#622 — a SHORT entry (<=3 bullets, class .entry-atomic below)
         stays one unit. A LONG entry (>3 bullets) may now break. */
    }

    /* #622 — break policy. SHORT entries (<=3 bullets, and every education/
       certification entry, which never carries bullets) stay atomic, same as
       #357. LONG entries (>3 bullets) may break, but the head (title/company/
       dates) + first 2 bullets is one keep-together group (.entry-lead), the
       last 2 bullets are another (.entry-tail), and every remaining bullet is
       itself atomic (.section li) — never mid-sentence. List sections
       (certifications/education/...) follow the same shape at the item
       level via .section-atomic/.section-lead/.section-tail below, so a
       heading or a single stranded item never sits alone at a page foot. */
    .entry-atomic {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .entry-lead,
    .entry-tail {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .section li {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .entry-lead ~ .entry-bullets,
    .entry-tail .entry-bullets {
      margin-top: 0;
    }
    /* D-35: a SHORT project (<=3 bullets) stays one unit; a LONG one keeps its
       name + first 2 bullets together (.project-lead) and may break after. */
    .project-atomic,
    .project-lead {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .project-lead ~ .entry-bullets { margin-top: 0; }
    /* D-35: the nested projects never open a page without their role — the
       block before them (the role's lead or tail) travels with their first block. */
    .entry-projects {
      break-before: avoid;
      page-break-before: avoid;
    }
    /* D-35: when projects follow, a long role's last 2 bullets are no longer one
       unit — only the LAST bullet travels with the projects, so the break costs
       one bullet's height, not two. */
    .entry-tail.entry-tail-open {
      break-inside: auto;
      page-break-inside: auto;
    }
    .section-atomic {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .section-lead,
    .section-tail {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    /* List-section items here are bare divs (.skill-item, .lang-row), not
       .entry — they need their own atomicity rule directly. */
    .skill-item,
    .lang-row {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .entry-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }

    .entry-title {
      font-size: 10.5pt;
      font-weight: bold;
      color: var(--text);
    }

    .entry-dates {
      font-size: 8.5pt;
      color: var(--muted);
      white-space: nowrap;
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    }

    .entry-subtitle {
      font-size: 9.5pt;
      color: var(--muted);
      margin-bottom: 3pt;
    }

    /* Quantified role facts (#328) — deterministic furniture, never prose */
    .entry-facts {
      font-size: 8.5pt;
      color: var(--muted);
      margin-bottom: 3pt;
    }

    .entry-bullets {
      padding-left: 12pt;
      list-style-type: disc;
      margin-top: 3pt;
    }

    .entry-projects { margin-top: 5pt; }
    .entry-projects-title {
      /* D-6 (delivery run 4): the sub-label moves with its first project — never alone at a page foot. */
      break-after: avoid;
      page-break-after: avoid;
      font-size: 9pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--cv-primary);
      margin-bottom: 2pt;
    }
    .project-item { margin-bottom: 3pt; }
    .project-name { font-weight: 700; font-size: 10.5pt; }

    .entry-bullets li {
      margin-bottom: 1.5pt;
      font-size: 9.5pt;
    }

    .skill-item {
      font-size: 9.5pt;
      padding: 2pt 0;
      color: var(--text);
      border-bottom: 1px dotted var(--rule);
    }

    .lang-row {
      display: flex;
      justify-content: space-between;
      font-size: 9.5pt;
      padding: 2pt 0;
      border-bottom: 1px dotted var(--rule);
    }
    .lang-name { font-weight: 600; }
    .lang-level { color: var(--muted); }

    .summary-text {
      font-size: 10.5pt;
      line-height: 1.55;
      color: var(--text);
    }

    /* Signature (#F frontend, Nougat build 2) — lives in .col-right, the
       wider (2fr) column carrying summary/experience/projects; .col-left
       (1fr: skills/education/certs/languages) reads as the sidebar. */
    .signature-block { break-inside: avoid; page-break-inside: avoid; margin-top: 8mm; }
    .signature-block .signature-place-date { margin-bottom: 2mm; }
    .signature-block .signature-image { display: block; height: 14mm; width: auto; max-width: 60mm; }

    /* #621 — .page carries no padding of its own here: the coloured .header
       band's own top/left/right padding (18mm/20mm/20mm) was doing double
       duty as both the band's internal text inset AND the page's outer
       margin (the band sits flush at the paper edge with nothing else
       providing an outer margin); .header's bottom padding (14mm) is
       unrelated — it is the gap AFTER the band, before .body, and is kept.
       Likewise .body's own left/right padding (20mm/20mm) doubles as the
       page's side margin for every page after the header, and its bottom
       padding (16mm) is the page's bottom margin; .body's top padding
       (14mm) is unrelated (the gap after the band on page 1) and is kept.
       The uniform @page margin below is derived from those outer-facing
       values (top 18mm from .header / right+left 20mm, consistent between
       .header and .body / bottom 16mm from .body). Measured (minimal
       repro): a negative margin that reaches into the @page margin area is
       not painted there — so unlike the old margin:0 renderer, the header
       band can no longer bleed to the paper edge under a real @page margin.
       Design point 3 accepts this ("a printable margin beats bleed") — see
       the report for before/after screenshots. */
    @page {
      size: A4;
      margin: 18mm 20mm 16mm 20mm;
    }

    @media print {
      .page { width: auto; min-height: auto; margin: 0; }
      /* Band text inset (Hazelnut b4, 786:236): the band is inset by the @page margin,
         so with 0 inner padding its text touched the band's top/left/right edges
         (name 0.1 mm from the left edge, contact 1.1 mm from the top). 5/8 mm matches
         executive_letter's band; the band's total height stays 14 mm (5 + 9), so
         page-1 capacity is unchanged. */
      .header { padding: 5mm 8mm 9mm 8mm; }
      .body { padding: 14mm 0 0 0; }
    }
  </style>
</head>
<body>
<div class="page">

  <header class="header">
    <div class="header-inner">
      <div>
        <div class="header-name"><h1>{{ cv.contact.name }}</h1></div>
        {% if cv.work_history %}<div class="header-title">{{ cv.work_history[0].role }}</div>{% endif %}
      </div>
      <div style="display:flex;align-items:flex-start;gap:14pt;">
        <div class="header-contact">
          {% if cv.contact.location %}<div>{{ cv.contact.location }}</div>{% endif %}
          {% if cv.contact.phone %}<div>{{ cv.contact.phone }}</div>{% endif %}
          {% if cv.contact.email %}<div>{{ cv.contact.email }}</div>{% endif %}
          {% if cv.contact.linkedin %}<div>{{ cv.contact.linkedin }}</div>{% endif %}
        </div>
        {% if cv.show_photo and cv.contact.photo_url %}
        <div class="header-avatar">
          <img src="{{ cv.contact.photo_url }}" alt="Foto">
        </div>
        {% endif %}
      </div>
    </div>
  </header>

  <div class="body">
    <div class="col-left">
      {% if cv.skills %}
      {% set n_skills = cv.skills | length %}
      <div class="section{{ ' section-atomic' if n_skills <= 6 else '' }}">
        {% if n_skills > 6 %}<div class="section-lead">{% endif %}
        <div class="section-title">{{ labels.skills }}</div>
        {% for skill in cv.skills %}
        {% if n_skills > 6 and loop.index == 3 %}</div>{% endif %}
        {% if n_skills > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
        <div class="skill-item">{{ skill }}</div>
        {% endfor %}
        {% if n_skills > 6 %}</div>{% endif %}
      </div>
      {% endif %}

      {% if cv.education %}
      {% set n_edu = cv.education | length %}
      <div class="section{{ ' section-atomic' if n_edu <= 6 else '' }}">
        {% if n_edu > 6 %}<div class="section-lead">{% endif %}
        <div class="section-title">{{ labels.education }}</div>
        {% for edu in cv.education %}
        {% if n_edu > 6 and loop.index == 3 %}</div>{% endif %}
        {% if n_edu > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
        <div class="entry entry-atomic">
          <div class="entry-title">{{ edu.degree | education_title(edu.field) }}</div>
          <div class="entry-subtitle">{{ edu.institution }}</div>
          <div class="entry-dates">{% set edu_period = edu | period(labels.present) %}{{ edu_period.start }}{% if edu_period.dash %} – {% endif %}{{ edu_period.end }}</div>
        </div>
        {% endfor %}
        {% if n_edu > 6 %}</div>{% endif %}
      </div>
      {% endif %}

      {% if cv.certifications %}
      {% set n_certs = cv.certifications | length %}
      <div class="section{{ ' section-atomic' if n_certs <= 6 else '' }}">
        {% if n_certs > 6 %}<div class="section-lead">{% endif %}
        <div class="section-title">{{ labels.certifications }}</div>
        {% for cert in cv.certifications %}
        {% if n_certs > 6 and loop.index == 3 %}</div>{% endif %}
        {% if n_certs > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
        <div class="entry entry-atomic">
          <div class="entry-title">{{ cert.name }}</div>
          {% if cert.issuing_organization %}<div class="entry-subtitle">{{ cert.issuing_organization }}</div>{% endif %}
          <div class="entry-dates">{{ cert.date_obtained | month_year }}</div>
        </div>
        {% endfor %}
        {% if n_certs > 6 %}</div>{% endif %}
      </div>
      {% endif %}

      {% if cv.languages %}
      {% set n_langs = cv.languages | length %}
      <div class="section{{ ' section-atomic' if n_langs <= 6 else '' }}">
        {% if n_langs > 6 %}<div class="section-lead">{% endif %}
        <div class="section-title">{{ labels.languages }}</div>
        {% for lang in cv.languages %}
        {% if n_langs > 6 and loop.index == 3 %}</div>{% endif %}
        {% if n_langs > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
        <div class="lang-row">
          <span class="lang-name">{{ lang.language }}</span>
          <span class="lang-level">{{ lang.level }}</span>
        </div>
        {% endfor %}
        {% if n_langs > 6 %}</div>{% endif %}
      </div>
      {% endif %}
    </div>

    <div class="col-right">
      {% if cv.summary %}
      <div class="section">
        <div class="section-title">{{ labels.summary }}</div>
        <p class="summary-text">{{ cv.summary }}</p>
      </div>
      {% endif %}

      {% if cv.work_history %}
      <div class="section">
        <div class="section-title">{{ labels.experience }}</div>
        {% for job in cv.work_history %}
        {% set n_bullets = job.bullets | length %}
        {# D-35: an entry is atomic only when ALL of it is short — its own bullets
           PLUS its nested projects' bullets (a 2-bullet role with a 5-bullet project
           was one unbreakable block and left page 1 ~40 % empty). #}
        {% set n_proj_bullets = job.projects | map(attribute='bullets') | map('length') | sum %}
        <div class="entry{{ ' entry-atomic' if n_bullets + n_proj_bullets <= 3 else '' }}">
          {% set head %}
          <div class="entry-header">
            <div class="entry-title">{{ job.role }}</div>
            <div class="entry-dates">{% set job_period = job | period(labels.present) %}{{ job_period.start }}{% if job_period.dash %} – {% endif %}{{ job_period.end }}</div>
          </div>
          <div class="entry-subtitle">{{ job.company }}</div>
          {# Founder ruling P-1: one fact line, numbers only, no labels, no industry
             (filters.role_facts — shared with the .docx export). #}
          {% set role_facts_text = job | role_facts(lang) %}
          {% if role_facts_text %}
          <div class="entry-facts">{{ role_facts_text }}</div>
          {% endif %}
          {% endset %}
          {% if n_bullets > 3 %}
          <div class="entry-lead">
            {{ head }}
            <ul class="entry-bullets">
              {% for bullet in job.bullets[:2] %}
              <li>{{ bullet }}</li>
              {% endfor %}
            </ul>
          </div>
          {% if n_bullets > 4 %}
          <ul class="entry-bullets">
            {% for bullet in job.bullets[2:-2] %}
            <li>{{ bullet }}</li>
            {% endfor %}
          </ul>
          {% endif %}
          <div class="entry-tail{{ ' entry-tail-open' if job.projects else '' }}">
            <ul class="entry-bullets">
              {% for bullet in job.bullets[-2:] %}
              <li>{{ bullet }}</li>
              {% endfor %}
            </ul>
          </div>
          {% else %}
          {% if job.projects and n_bullets + n_proj_bullets > 3 %}
          {# D-35: a short role WITH nested projects breaks like a long one — head +
             first 2 own bullets keep together (.entry-lead), the rest follow, and the
             projects travel with the block before them (.entry-projects
             break-before: avoid): they never open a page on their own. #}
          <div class="entry-lead">
            {{ head }}
            {% if job.bullets %}<ul class="entry-bullets">{% for bullet in job.bullets[:2] %}<li>{{ bullet }}</li>{% endfor %}</ul>{% endif %}
          </div>
          {% if n_bullets > 2 %}<ul class="entry-bullets">{% for bullet in job.bullets[2:] %}<li>{{ bullet }}</li>{% endfor %}</ul>{% endif %}
          {% else %}
          {{ head }}
          {% if job.bullets %}
          <ul class="entry-bullets">
            {% for bullet in job.bullets %}
            <li>{{ bullet }}</li>
            {% endfor %}
          </ul>
          {% endif %}
          {% endif %}
          {% endif %}
          {% if job.projects %}
          <div class="entry-projects">
            <div class="entry-projects-title">{{ labels.projects }}</div>
            {% for project in job.projects %}
            {% set n_pb = project.bullets | length %}
            <div class="project-item{{ ' project-atomic' if n_pb <= 1 else '' }}">
              {% if n_pb > 1 %}
              {# D-35: a project with more than one bullet may break — its name + first bullet keep together. #}
              <div class="project-lead">
                <div class="project-name">{{ project.name }}</div>
                <ul class="entry-bullets">{% for bullet in project.bullets[:1] %}<li>{{ bullet }}</li>{% endfor %}</ul>
              </div>
              <ul class="entry-bullets">{% for bullet in project.bullets[1:] %}<li>{{ bullet }}</li>{% endfor %}</ul>
              {% else %}
              <div class="project-name">{{ project.name }}</div>
              {% if project.bullets %}
              <ul class="entry-bullets">{% for bullet in project.bullets %}<li>{{ bullet }}</li>{% endfor %}</ul>
              {% endif %}
              {% endif %}
            </div>
            {% endfor %}
          </div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% if cv.projects %}
      <div class="section">
        <div class="section-title">{{ labels.projects }}</div>
        {% for project in cv.projects %}
        {% set n_bullets = project.bullets | length %}
        <div class="entry{{ ' entry-atomic' if n_bullets <= 3 else '' }}">
          {% if n_bullets > 3 %}
          <div class="entry-lead">
            <div class="entry-header">
              <div class="entry-title">{{ project.name }}</div>
            </div>
            <ul class="entry-bullets">
              {% for bullet in project.bullets[:2] %}<li>{{ bullet }}</li>{% endfor %}
            </ul>
          </div>
          {% if n_bullets > 4 %}
          <ul class="entry-bullets">
            {% for bullet in project.bullets[2:-2] %}<li>{{ bullet }}</li>{% endfor %}
          </ul>
          {% endif %}
          <div class="entry-tail">
            <ul class="entry-bullets">
              {% for bullet in project.bullets[-2:] %}<li>{{ bullet }}</li>{% endfor %}
            </ul>
          </div>
          {% else %}
          <div class="entry-header">
            <div class="entry-title">{{ project.name }}</div>
          </div>
          {% if project.bullets %}
          <ul class="entry-bullets">
            {% for bullet in project.bullets %}<li>{{ bullet }}</li>{% endfor %}
          </ul>
          {% endif %}
          {% endif %}
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {% if signature_image %}
      <div class="signature-block">
        {% if signature_place_date %}<div class="signature-place-date">{{ signature_place_date }}</div>{% endif %}
        <img class="signature-image" src="{{ signature_image }}" alt="">
      </div>
      {% endif %}
    </div>
  </div>

</div>
</body>
</html>
