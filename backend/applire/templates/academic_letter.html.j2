<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8"/>
  <title>{{ labels.document_title }} – {{ letter.header.name }}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --primary: {{ color.primary }}; }
    body { font-family: "Palatino Linotype", Georgia, serif; font-size: 10.5pt; line-height: 1.55; color: #111; background: #fff; }
    .page { width: 210mm; min-height: 297mm; margin: 0 auto; padding: 20mm 24mm; }
    /* Header = the CV twin's header (academic.html.j2): centred serif name, centred contact
       line with middots, 1.5px accent rule. */
    .header { text-align: center; border-bottom: 1.5px solid var(--primary); padding-bottom: 10pt; margin-bottom: 12mm; font-family: "Times New Roman", Times, serif; }
    .header-name { font-size: 18pt; font-weight: bold; letter-spacing: 0.03em; margin-bottom: 4pt; line-height: 1.5; }
    .header-contact { font-size: 9.5pt; color: #444; line-height: 1.8; }
    .recipient { margin-bottom: 8mm; font-size: 10pt; }
    .date { text-align: right; margin-bottom: 6mm; font-style: italic; color: #555; }
    .subject { font-weight: bold; font-size: 11pt; margin-bottom: 7mm; text-align: center; }
    .body p { margin-bottom: 5mm; text-align: justify; }
    /* #429: keep-together + tighter signature air, same rationale as
       lebenslauf_letter — a budget-length body must fit the 1-page norm.
       #547: break-inside:avoid pushes the WHOLE block to page 2 once it no
       longer fits the remainder of page 1 — even a budget-length body left
       just ~1cm short of the block's own margins triggered this, orphaning
       the block alone on page 2 with the freed space still visible on page
       1. 4mm less air (again) shrinks the atomic unit so it fits the
       remainder more often; this is a probability reduction, not a proof —
       CSS pagination cannot guarantee fit without content-aware sizing. */
    .signature { break-inside: avoid; page-break-inside: avoid; break-before: avoid; page-break-before: avoid; margin-top: 5mm; }
    /* 786:L41 keep-with-signature: the last paragraph and the closing move as one unit, so a page break never leaves the closing alone. */
    .body p:last-child { break-after: avoid; page-break-after: avoid; }
    .signature .closing { margin-bottom: 7mm; }
    .signature-image { display: block; height: 14mm; width: auto; max-width: 60mm; margin: 0 0 1mm; }
    .signature.has-signature .closing { margin-bottom: 2mm; }
    /* #621 — the visual margin now lives in @page (Chromium's paged-media
       engine re-applies it on every page); .page's own padding/size, which
       used to BE the margin on the print path, is neutralised in print so it
       doesn't double up with @page. Kept for the on-screen HTML preview
       above (width/min-height/padding), which never goes through @page. */
    @page {
      size: A4;
      margin: 20mm 24mm 20mm 24mm;
    }
    @media print {
      body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .page { padding: 0; width: auto; min-height: auto; margin: 0; }
    }
  </style>
</head>
<body>
<div class="page">
  <div class="header">
    <div class="header-name">{{ letter.header.name }}</div>
    <div class="header-contact">{% if letter.header.address %}<span>{{ letter.header.address }}</span>{% endif %}{% if letter.header.email %} &nbsp;·&nbsp; <span>{{ letter.header.email }}</span>{% endif %}{% if letter.header.phone %} &nbsp;·&nbsp; <span>{{ letter.header.phone }}</span>{% endif %}</div>
  </div>
  <div class="recipient">{% if letter.recipient.name %}{{ letter.recipient.name }}<br>{% endif %}{% if letter.recipient.title %}{{ letter.recipient.title }}<br>{% endif %}{% if letter.recipient.company %}{{ letter.recipient.company }}<br>{% endif %}{% if letter.recipient.address %}{{ letter.recipient.address }}{% endif %}</div>
  <div class="date">{{ letter.recipient.date }}</div>
  <div class="subject">{{ subject }}{% if letter.recipient.company %} — {{ letter.recipient.company }}{% endif %}</div>
  <div class="body">{% for para in letter.body.paragraphs %}<p>{{ para }}</p>{% endfor %}</div>
  <div class="signature{% if signature_image %} has-signature{% endif %}"><div class="closing">{{ letter.signature.closing }}{{ labels.closing_punctuation }}</div>{% if signature_image %}<img class="signature-image" src="{{ signature_image }}" alt="">{% endif %}<div>{{ letter.signature.name }}</div></div>
</div>
</body>
</html>
