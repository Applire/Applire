<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --surface: {{ color.surface }}; --surface-text: {{ color.surface_text }}; --primary: {{ color.primary }}; }
    body { font-family: "Segoe UI", Arial, sans-serif; font-size: 10pt; background: #fff; color: #1a1a1a; }
    .page { width: 210mm; min-height: 297mm; margin: 0 auto; display: flex; }
    .sidebar { width: 55mm; background: var(--surface); color: var(--surface-text); padding: 16mm 8mm 16mm 10mm; flex-shrink: 0; }
    .sidebar-name { font-size: 12pt; font-weight: bold; margin-bottom: 8mm; }
    /* ADR-039: the muted look is baked into an OPAQUE colour via color-mix
       instead of `opacity`. A sub-1 opacity layer made Chromium emit the
       sidebar text as a separate group that pypdf extracted glyph-by-glyph
       ("j o e r g . m u e l l e r @ …") and reordered after the body — both
       failing the local extraction audit. Opaque colour extracts intact. */
    .sidebar-label { font-size: 7.5pt; text-transform: uppercase; letter-spacing: 1px; color: color-mix(in srgb, var(--surface-text) 70%, var(--surface)); margin-bottom: 2mm; margin-top: 6mm; }
    .sidebar-value { font-size: 8.5pt; color: color-mix(in srgb, var(--surface-text) 90%, var(--surface)); }
    .main { flex: 1; padding: 16mm 14mm 16mm 12mm; }
    .recipient { margin-bottom: 8mm; font-size: 10pt; }
    .date { text-align: right; margin-bottom: 6mm; color: #666; }
    .subject { font-weight: 700; font-size: 11pt; margin-bottom: 7mm; color: var(--primary); }
    .body p { margin-bottom: 5mm; }
    /* #547: break-inside:avoid pushes the WHOLE block to page 2 once it no
       longer fits the remainder of page 1, orphaning it alone with the
       freed space still visible on page 1 — 4mm less air shrinks the
       atomic unit so it fits the remainder more often (see academic_letter
       for the full rationale; same fix, N templates — ADR-066). */
    .signature { break-inside: avoid; page-break-inside: avoid; margin-top: 6mm; }
    .signature .closing { margin-bottom: 8mm; }
    /* #621 — .page carries no padding of its own here: the sidebar/main
       columns' OWN padding was doing double duty as both "gap between the two
       columns" and "the page's outer margin" (sidebar top 16mm / left 10mm /
       bottom 16mm; main top 16mm / right 14mm / bottom 16mm — outer edges,
       consistent between the two columns on every side they share). The
       uniform @page margin below is derived from those outer-facing values.
       Measured (minimal repro): a negative margin that reaches into the
       @page margin area is not painted there — so unlike the old margin:0
       renderer, the sidebar's colour can no longer bleed to the paper edge
       under a real @page margin. Design point 3 accepts this ("a printable
       margin beats bleed") — see the report for before/after screenshots.
       Only the OUTER-facing padding (the leg that used to face the paper
       edge) is zeroed in print; the INNER-facing padding — sidebar's right /
       main's left, the visual gap between the two columns — is untouched. */
    @page {
      size: A4;
      margin: 16mm 14mm 16mm 10mm;
    }
    @media print {
      body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .page { width: auto; min-height: auto; margin: 0; }
      .sidebar { padding: 0 8mm 0 0; }
      .main { padding: 0 0 0 12mm; }
    }
  </style>
</head>
<body>
<div class="page">
  <div class="sidebar">
    <div class="sidebar-name">{{ letter.header.name }}</div>
    {% if letter.header.email %}<div class="sidebar-label">{{ labels.email }}</div><div class="sidebar-value">{{ letter.header.email }}</div>{% endif %}
    {% if letter.header.phone %}<div class="sidebar-label">{{ labels.phone }}</div><div class="sidebar-value">{{ letter.header.phone }}</div>{% endif %}
    {% if letter.header.address %}<div class="sidebar-label">{{ labels.address }}</div><div class="sidebar-value">{{ letter.header.address }}</div>{% endif %}
  </div>
  <div class="main">
    <div class="recipient">{% if letter.recipient.name %}{{ letter.recipient.name }}<br>{% endif %}{% if letter.recipient.company %}{{ letter.recipient.company }}<br>{% endif %}{% if letter.recipient.address %}{{ letter.recipient.address }}{% endif %}</div>
    <div class="date">{{ letter.recipient.date }}</div>
    <div class="subject">{{ subject }}{% if letter.recipient.company %} — {{ letter.recipient.company }}{% endif %}</div>
    <div class="body">{% for para in letter.body.paragraphs %}<p>{{ para }}</p>{% endfor %}</div>
    <div class="signature"><div class="closing">{{ letter.signature.closing }}{{ labels.closing_punctuation }}</div><div>{{ letter.signature.name }}</div></div>
  </div>
</div>
</body>
</html>
