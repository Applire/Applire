<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8"/>
  <title>{{ labels.document_title }} – {{ letter.header.name }}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --surface: {{ color.surface }}; --surface-text: {{ color.surface_text }}; --primary: {{ color.primary }}; }
    body { font-family: "Segoe UI", Arial, sans-serif; font-size: 10pt; background: #fff; color: #1a1a1a; }
    /* P-5 (founder ruling, Hazelnut build 8): the letter follows the CV twin
       (creative_sidebar.html.j2) — no side column; a coloured band on top with the
       name and a contact line (letters carry no photo), then the letter at full
       width with symmetric 16 mm margins. */
    /* On screen (preview, thumbnail) the sheet carries the margin itself; in print
       the @page margin does (16 mm on every side) and .page is reset below. */
    .page { width: 210mm; min-height: 297mm; margin: 0 auto; padding: 16mm; }
    .hero { background: var(--surface); color: var(--surface-text); padding: 7mm 10mm; border-radius: 2mm; margin-bottom: 9mm; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .hero-name { font-size: 18pt; font-weight: bold; line-height: 1.2; color: var(--surface-text); margin-bottom: 3pt; }
    /* ADR-039: muted tones are opaque colours via color-mix, never `opacity` — a
       sub-1 opacity layer made pypdf extract the contact text glyph by glyph
       ("j o e r g . m u e l l e r @ …") and after the body. */
    .hero-contact { font-size: 9pt; line-height: 1.6; color: var(--surface-text); }
    .hero-contact span + span::before { content: "·"; margin: 0 6pt; color: color-mix(in srgb, var(--surface-text) 60%, var(--surface)); }
    .main { }
    .recipient { margin-bottom: 8mm; font-size: 10pt; }
    .date { text-align: right; margin-bottom: 6mm; color: #666; }
    .subject { font-weight: 700; font-size: 11pt; margin-bottom: 7mm; color: var(--primary); }
    .body p { margin-bottom: 5mm; }
    /* #547: break-inside:avoid pushes the WHOLE block to page 2 once it no
       longer fits the remainder of page 1, orphaning it alone with the
       freed space still visible on page 1 — 4mm less air shrinks the
       atomic unit so it fits the remainder more often (see academic_letter
       for the full rationale; same fix, N templates — ADR-066). */
    .signature { break-inside: avoid; page-break-inside: avoid; break-before: avoid; page-break-before: avoid; margin-top: 6mm; }
    /* 786:L41 keep-with-signature: the last paragraph and the closing move as one unit, so a page break never leaves the closing alone. */
    .body p:last-child { break-after: avoid; page-break-after: avoid; }
    .signature .closing { margin-bottom: 8mm; }
    .signature-image { display: block; height: 14mm; width: auto; max-width: 60mm; margin: 0 0 1mm; }
    .signature.has-signature .closing { margin-bottom: 2mm; }
    /* #621 / P-5: the page margin is the @page margin (16 mm on every side); the
       band sits inside it ("a printable margin beats bleed"). */
    @page {
      size: A4;
      margin: 16mm 16mm 16mm 16mm;
    }
    @media print {
      body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .page { width: auto; min-height: auto; margin: 0; padding: 0; }
    }
  </style>
</head>
<body>
<div class="page">
  <header class="hero">
    <div class="hero-name">{% for tok in letter.header.name.split() %}<span style="white-space: nowrap;">{{ tok }}</span>{% if not loop.last %} {% endif %}{% endfor %}</div>
    <div class="hero-contact">{% if letter.header.address %}<span>{{ letter.header.address }}</span>{% endif %}{% if letter.header.phone %}<span>{{ letter.header.phone }}</span>{% endif %}{% if letter.header.email %}<span>{{ letter.header.email }}</span>{% endif %}</div>
  </header>
  <div class="main">
    <div class="recipient">{% if letter.recipient.name %}{{ letter.recipient.name }}<br>{% endif %}{% if letter.recipient.company %}{{ letter.recipient.company }}<br>{% endif %}{% if letter.recipient.address %}{{ letter.recipient.address }}{% endif %}</div>
    <div class="date">{{ letter.recipient.date }}</div>
    <div class="subject">{{ subject }}{% if letter.recipient.company %} — {{ letter.recipient.company }}{% endif %}</div>
    <div class="body">{% for para in letter.body.paragraphs %}<p>{{ para }}</p>{% endfor %}</div>
    <div class="signature{% if signature_image %} has-signature{% endif %}"><div class="closing">{{ letter.signature.closing }}{{ labels.closing_punctuation }}</div>{% if signature_image %}<img class="signature-image" src="{{ signature_image }}" alt="">{% endif %}<div>{{ letter.signature.name }}</div></div>
  </div>
</div>
</body>
</html>
