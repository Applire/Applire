<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8"/>
  <title>{{ labels.document_title }} – {{ letter.header.name }}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --primary: {{ color.primary }};
      --surface: {{ color.surface }};
      --surface-text: {{ color.surface_text }};
    }
    body { font-family: Georgia, "Times New Roman", serif; font-size: 10.5pt; line-height: 1.65; color: #1a1a2e; background: #fff; }
    .page { width: 210mm; min-height: 297mm; margin: 0 auto; padding: 0 22mm 20mm 25mm; }
    /* Header = the CV twin's header (executive.html.j2): full-width surface band, bold
       mixed-case serif name (24pt, 0.04em), sans contact lines stacked right-aligned
       at 0.85 opacity. The CV's role line under the name has no source in a letter's
       header data, so it is not printed. */
    .header { background: var(--surface); color: var(--surface-text); padding: 5mm 8mm; margin-bottom: 10mm; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .header-inner { display: flex; justify-content: space-between; align-items: flex-start; gap: 16pt; line-height: 1.5; }
    .header-name { font-size: 24pt; font-weight: bold; letter-spacing: 0.04em; white-space: nowrap; flex-shrink: 0; }
    .header-contact { text-align: right; font-size: 9pt; opacity: 0.85; line-height: 1.8; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; white-space: nowrap; }
    .recipient { margin-bottom: 8mm; font-size: 10pt; }
    .date { text-align: right; margin-bottom: 6mm; color: #666; }
    .subject { font-weight: bold; font-size: 11pt; margin-bottom: 7mm; color: #1a1a2e; }
    .body p { margin-bottom: 5mm; text-align: justify; }
    /* #547: break-inside:avoid pushes the WHOLE block to page 2 once it no
       longer fits the remainder of page 1, orphaning it alone with the
       freed space still visible on page 1 — 4mm less air shrinks the
       atomic unit so it fits the remainder more often (see academic_letter
       for the full rationale; same fix, N templates — ADR-066). */
    .signature { break-inside: avoid; page-break-inside: avoid; margin-top: 6mm; }
    .signature .closing { margin-bottom: 8mm; }
    .signature-image { display: block; height: 14mm; width: auto; max-width: 60mm; margin: 0 0 1mm; }
    .signature.has-signature .closing { margin-bottom: 2mm; }
    /* #621 deviation from design point 1, measured and then measured again
       (not a silent guess): .page's own top padding is 0 BY DESIGN, so the
       coloured .header band bleeds flush to the paper's top edge on page 1;
       left/right/bottom (22mm/25mm/20mm) are normal margin, already
       supplied by .page's own padding today, and carry over unchanged.
       "Use the value in force" literally would mean an @page top margin of
       0mm — but @page applies to EVERY page, so that would leave page 2+
       with no top margin at all, reproducing #621 on this one template.
       First attempt: a uniform 20mm top margin on every page (matching this
       template's own bottom margin and the ~20mm convention shared by every
       other letter template) — implemented, then measured against the full
       suite: it pushed `test_letter_signature_orphans_less_often_547`
       (executive, budget-length + 1 sentence) from 1 page to 2, because
       page 1 never had a real top margin to begin with — the ~20mm now
       "reused" from the other templates was ~20mm of NEW vertical space,
       not a relocation of an existing value. Reverted. Fix instead with
       `@page :first`, verified honoured by this Chromium version with a
       minimal repro (page 1 text stayed flush at the :first override, page
       2 landed at exactly the outer rule's margin): page 1 keeps its
       existing 0mm top (band still bleeds, #547 fixture unaffected) and
       only page 2+ gets a real top margin, which is exactly what #621
       needs. Net: zero visual change to this template — the only one of
       the four bleed templates without a before/after screenshot pair for
       that reason (nothing to show; see the report). */
    @page {
      size: A4;
      margin: 20mm 22mm 20mm 25mm;
    }
    @page :first {
      margin-top: 0mm;
    }
    @media print {
      body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .page { padding: 0; width: auto; min-height: auto; margin: 0; }
    }
  </style>
</head>
<body>
<div class="page">
  <div class="header">
    <div class="header-inner">
      <div class="header-name">{{ letter.header.name }}</div>
      <div class="header-contact">
        {% if letter.header.address %}<div>{{ letter.header.address }}</div>{% endif %}
        {% if letter.header.phone %}<div>{{ letter.header.phone }}</div>{% endif %}
        {% if letter.header.email %}<div>{{ letter.header.email }}</div>{% endif %}
      </div>
    </div>
  </div>

  <div class="recipient">
    {% if letter.recipient.name %}{{ letter.recipient.name }}<br>{% endif %}
    {% if letter.recipient.title %}{{ letter.recipient.title }}<br>{% endif %}
    {% if letter.recipient.company %}{{ letter.recipient.company }}<br>{% endif %}
    {% if letter.recipient.address %}{{ letter.recipient.address }}{% endif %}
  </div>

  <div class="date">{{ letter.recipient.date }}</div>
  <div class="subject">{{ subject }}{% if letter.recipient.company %} — {{ letter.recipient.company }}{% endif %}</div>

  <div class="body">
    {% for para in letter.body.paragraphs %}<p>{{ para }}</p>{% endfor %}
  </div>

  <div class="signature{% if signature_image %} has-signature{% endif %}">
    <div class="closing">{{ letter.signature.closing }}{{ labels.closing_punctuation }}</div>
    {% if signature_image %}<img class="signature-image" src="{{ signature_image }}" alt="">{% endif %}
    <div>{{ letter.signature.name }}</div>
  </div>
</div>
</body>
</html>
