<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8" />
  <title>{{ labels.document_title }} – {{ cv.contact.name }}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cv-primary: {{ color.primary }};
      --cv-primary-tint: {{ color.primary_tint }};
      --bg: #0d1117;
      --bg2: #161b22;
      --border: #30363d;
      --text: #e6edf3;
      --muted: #8b949e;
    }

    body {
      font-family: "Courier New", Courier, monospace;
      font-size: 10pt;
      line-height: 1.55;
      color: var(--text);
      background: var(--bg);
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      padding: 16mm 20mm 16mm 20mm;
    }

    .accent-strip {
      height: 3pt;
      background: var(--cv-primary);
      margin-bottom: 16pt;
      border-radius: 1pt;
    }

    .header {
      border-bottom: 1px solid var(--border);
      padding-bottom: 12pt;
      margin-bottom: 16pt;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }

    .header-name {
      font-size: 20pt;
      font-weight: bold;
      color: var(--cv-primary);
      letter-spacing: -0.01em;
    }

    .header-handle {
      font-size: 9pt;
      color: var(--muted);
      margin-top: 2pt;
    }

    .header-contact {
      text-align: right;
      font-size: 8.5pt;
      color: var(--muted);
      line-height: 1.8;
    }

    .section { margin-bottom: 16pt; }

    .section-label {
      font-size: 8pt;
      color: var(--muted);
      letter-spacing: 0.05em;
      margin-bottom: 8pt;
      /* #357 — a section heading never orphans at the foot of a page. */
      break-after: avoid;
      page-break-after: avoid;
    }

    .section-label::before { content: "// "; color: var(--border); }

    .entry {
      margin-bottom: 10pt;
      /* #357/#622 — a SHORT entry (<=3 bullets, class .entry-atomic below)
         stays one unit. A LONG entry (>3 bullets) may now break. */
    }

    /* #622 — break policy. SHORT entries (<=3 bullets, and every education/
       certification entry, which never carries bullets) stay atomic, same as
       #357. LONG entries (>3 bullets) may break, but the head (title/company/
       dates) + first 2 bullets is one keep-together group (.entry-lead), the
       last 2 bullets are another (.entry-tail), and every remaining bullet is
       itself atomic (.section li) — never mid-sentence. List sections
       (certifications/education/...) follow the same shape at the item
       level via .section-atomic/.section-lead/.section-tail below, so a
       heading or a single stranded item never sits alone at a page foot. */
    .entry-atomic {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .entry-lead,
    .entry-tail {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .section li {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .entry-lead ~ .entry-bullets,
    .entry-tail .entry-bullets {
      margin-top: 0;
    }
    .project-item {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .section-atomic {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .section-lead,
    .section-tail {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .lang-row {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .entry-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 1pt;
    }

    .entry-title {
      font-size: 10.5pt;
      font-weight: bold;
      color: var(--cv-primary);
    }

    .entry-dates {
      font-size: 8.5pt;
      color: var(--muted);
    }

    .entry-subtitle {
      font-size: 9pt;
      color: var(--muted);
      margin-bottom: 3pt;
    }

    /* Quantified role facts (#328) — deterministic furniture, never prose */
    .entry-facts {
      font-size: 8.5pt;
      color: var(--muted);
      margin-bottom: 3pt;
    }

    .entry-bullets {
      padding-left: 12pt;
      list-style-type: none;
      margin-top: 3pt;
    }

    .entry-bullets li::before { content: "▸ "; color: var(--cv-primary); }

    .entry-projects { margin-top: 5pt; }
    .entry-projects-title {
      font-family: "SF Mono", "JetBrains Mono", "Fira Code", monospace;
      font-size: 8.5pt;
      letter-spacing: 0.04em;
      color: var(--cv-primary);
      margin-bottom: 2pt;
    }
    .project-item { margin-bottom: 3pt; }
    .project-name { font-weight: 600; font-size: 9.5pt; }

    .entry-bullets li {
      margin-bottom: 2pt;
      font-size: 9.5pt;
      color: var(--text);
    }

    .skills-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 4pt 6pt;
      list-style: none;
    }

    .skills-grid li {
      font-size: 8.5pt;
      padding: 2pt 7pt;
      background: var(--bg2);
      border: 1px solid var(--cv-primary);
      border-radius: 2pt;
      color: var(--cv-primary);
    }

    .summary-text {
      font-size: 10pt;
      color: var(--text);
      line-height: 1.55;
    }

    .lang-row {
      display: flex;
      gap: 8pt;
      font-size: 9.5pt;
      margin-bottom: 3pt;
    }
    .lang-name { color: var(--cv-primary); font-weight: bold; }
    .lang-level { color: var(--muted); }

    /* #621 — the visual margin now lives in @page (Chromium's paged-media
       engine re-applies it on every page); .page's own padding/size, which
       used to BE the margin on the print path, is neutralised in print so it
       doesn't double up with @page. Kept for the on-screen HTML preview
       above (width/min-height/padding), which never goes through @page. */
    @page {
      size: A4;
      margin: 16mm 20mm 16mm 20mm;
    }

    @media print {
      .page { padding: 0; width: auto; min-height: auto; margin: 0; }
    }
  </style>
</head>
<body>
<div class="page">

  <div class="accent-strip"></div>

  <header class="header">
    <div>
      <div class="header-name">{{ cv.contact.name }}</div>
      {% if cv.contact.linkedin %}
      <div class="header-handle">{{ cv.contact.linkedin }}</div>
      {% endif %}
    </div>
    <div class="header-contact">
      {% if cv.contact.location %}<div>{{ cv.contact.location }}</div>{% endif %}
      {% if cv.contact.email %}<div>{{ cv.contact.email }}</div>{% endif %}
      {% if cv.contact.phone %}<div>{{ cv.contact.phone }}</div>{% endif %}
    </div>
  </header>

  {% if cv.summary %}
  <div class="section">
    <div class="section-label">{{ labels.summary | lower }}</div>
    <p class="summary-text">{{ cv.summary }}</p>
  </div>
  {% endif %}

  {% if cv.skills %}
  {% set n_skills = cv.skills | length %}
  <div class="section{{ ' section-atomic' if n_skills <= 6 else '' }}">
    {% if n_skills > 6 %}<div class="section-lead">{% endif %}
    <div class="section-label">{{ labels.skills | lower }}</div>
    <ul class="skills-grid">
      {% for skill in cv.skills %}
      {% if n_skills > 6 and loop.index == 3 %}</ul></div><ul class="skills-grid">{% endif %}
      {% if n_skills > 6 and loop.revindex == 2 %}</ul><div class="section-tail"><ul class="skills-grid">{% endif %}
      <li>{{ skill }}</li>
      {% endfor %}
    </ul>
    {% if n_skills > 6 %}</div>{% endif %}
  </div>
  {% endif %}

  {% if cv.work_history %}
  <div class="section">
    <div class="section-label">{{ labels.experience | lower }}</div>
    {% for job in cv.work_history %}
    {% set n_bullets = job.bullets | length %}
    <div class="entry{{ ' entry-atomic' if n_bullets <= 3 else '' }}">
      {% set head %}
      <div class="entry-header">
        <div class="entry-title">{{ job.role }}</div>
        <div class="entry-dates">{{ job.start_date | month_year }} – {{ job.end_date | month_year if job.end_date else labels.present }}</div>
      </div>
      <div class="entry-subtitle">{{ job.company }}</div>
      {% set role_facts = [] %}
      {% if job.team_size is not none %}{% set _ = role_facts.append(labels.role_team_size ~ ': ' ~ job.team_size) %}{% endif %}
      {% set budget_text = job.budget_managed | budget_display(lang) %}{% if budget_text %}{% set _ = role_facts.append(labels.role_budget ~ ': ' ~ budget_text) %}{% endif %}
      {% if job.industry_context %}{% set _ = role_facts.append(labels.role_industry ~ ': ' ~ job.industry_context) %}{% endif %}
      {% if role_facts %}
      <div class="entry-facts">{{ role_facts | join(' · ') }}</div>
      {% endif %}
      {% endset %}
      {% if n_bullets > 3 %}
      <div class="entry-lead">
        {{ head }}
        <ul class="entry-bullets">
          {% for bullet in job.bullets[:2] %}
          <li>{{ bullet }}</li>
          {% endfor %}
        </ul>
      </div>
      {% if n_bullets > 4 %}
      <ul class="entry-bullets">
        {% for bullet in job.bullets[2:-2] %}
        <li>{{ bullet }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      <div class="entry-tail">
        <ul class="entry-bullets">
          {% for bullet in job.bullets[-2:] %}
          <li>{{ bullet }}</li>
          {% endfor %}
        </ul>
      </div>
      {% else %}
      {{ head }}
      {% if job.bullets %}
      <ul class="entry-bullets">
        {% for bullet in job.bullets %}
        <li>{{ bullet }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      {% endif %}
      {% if job.projects %}
      <div class="entry-projects">
        <div class="entry-projects-title">{{ labels.projects | lower }}</div>
        {% for project in job.projects %}
        <div class="project-item">
          <div class="project-name">{{ project.name }}</div>
          {% if project.bullets %}
          <ul class="entry-bullets">
            {% for bullet in project.bullets %}<li>{{ bullet }}</li>{% endfor %}
          </ul>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if cv.projects %}
  <div class="section">
    <div class="section-label">{{ labels.projects | lower }}</div>
    {% for project in cv.projects %}
    {% set n_bullets = project.bullets | length %}
    <div class="entry{{ ' entry-atomic' if n_bullets <= 3 else '' }}">
      {% if n_bullets > 3 %}
      <div class="entry-lead">
        <div class="entry-header">
          <div class="entry-title">{{ project.name }}</div>
        </div>
        <ul class="entry-bullets">
          {% for bullet in project.bullets[:2] %}<li>{{ bullet }}</li>{% endfor %}
        </ul>
      </div>
      {% if n_bullets > 4 %}
      <ul class="entry-bullets">
        {% for bullet in project.bullets[2:-2] %}<li>{{ bullet }}</li>{% endfor %}
      </ul>
      {% endif %}
      <div class="entry-tail">
        <ul class="entry-bullets">
          {% for bullet in project.bullets[-2:] %}<li>{{ bullet }}</li>{% endfor %}
        </ul>
      </div>
      {% else %}
      <div class="entry-header">
        <div class="entry-title">{{ project.name }}</div>
      </div>
      {% if project.bullets %}
      <ul class="entry-bullets">
        {% for bullet in project.bullets %}<li>{{ bullet }}</li>{% endfor %}
      </ul>
      {% endif %}
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if cv.education %}
  {% set n_edu = cv.education | length %}
  <div class="section{{ ' section-atomic' if n_edu <= 6 else '' }}">
    {% if n_edu > 6 %}<div class="section-lead">{% endif %}
    <div class="section-label">{{ labels.education | lower }}</div>
    {% for edu in cv.education %}
    {% if n_edu > 6 and loop.index == 3 %}</div>{% endif %}
    {% if n_edu > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
    <div class="entry entry-atomic">
      <div class="entry-header">
        <div class="entry-title">{{ edu.degree | education_title(edu.field) }}</div>
        <div class="entry-dates">{{ edu.start_date | month_year }}{% if edu.start_date %} – {% endif %}{{ edu.end_date | month_year if edu.end_date else (labels.present if edu.start_date else "") }}</div>
      </div>
      <div class="entry-subtitle">{{ edu.institution }}</div>
    </div>
    {% endfor %}
    {% if n_edu > 6 %}</div>{% endif %}
  </div>
  {% endif %}

  {% if cv.certifications %}
  {% set n_certs = cv.certifications | length %}
  <div class="section{{ ' section-atomic' if n_certs <= 6 else '' }}">
    {% if n_certs > 6 %}<div class="section-lead">{% endif %}
    <div class="section-label">{{ labels.certifications | lower }}</div>
    {% for cert in cv.certifications %}
    {% if n_certs > 6 and loop.index == 3 %}</div>{% endif %}
    {% if n_certs > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
    <div class="entry entry-atomic">
      <div class="entry-header">
        <div class="entry-title">{{ cert.name }}</div>
        <div class="entry-dates">{{ cert.date_obtained | month_year }}</div>
      </div>
      {% if cert.issuing_organization %}<div class="entry-subtitle">{{ cert.issuing_organization }}</div>{% endif %}
    </div>
    {% endfor %}
    {% if n_certs > 6 %}</div>{% endif %}
  </div>
  {% endif %}

  {% if cv.languages %}
  {% set n_langs = cv.languages | length %}
  <div class="section{{ ' section-atomic' if n_langs <= 6 else '' }}">
    {% if n_langs > 6 %}<div class="section-lead">{% endif %}
    <div class="section-label">{{ labels.languages | lower }}</div>
    {% for lang in cv.languages %}
    {% if n_langs > 6 and loop.index == 3 %}</div>{% endif %}
    {% if n_langs > 6 and loop.revindex == 2 %}<div class="section-tail">{% endif %}
    <div class="lang-row">
      <span class="lang-name">{{ lang.language }}</span>
      <span class="lang-level">{{ lang.level }}</span>
    </div>
    {% endfor %}
    {% if n_langs > 6 %}</div>{% endif %}
  </div>
  {% endif %}

</div>
</body>
</html>
