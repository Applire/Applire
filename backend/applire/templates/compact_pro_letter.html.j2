<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8"/>
  <title>{{ labels.document_title }} – {{ letter.header.name }}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --primary: {{ color.primary }}; }
    /* ADR-039: disable ligatures — the fallback font's "ti"/"fi" ligature glyph
       extracts as a NUL byte in pypdf ("Posi<NUL>on"), corrupting the body text
       and failing the local extraction audit. No meaningful visual change. */
    body { font-family: "Calibri", "Segoe UI", Arial, sans-serif; font-size: 10pt; line-height: 1.5; color: #111; background: #fff; font-variant-ligatures: none; }
    .page { width: 210mm; min-height: 297mm; margin: 0 auto; padding: 16mm 22mm 16mm 25mm; }
    /* Header = the CV twin's header (compact_pro.html.j2): 17pt bold name left, 8pt muted
       contact line right (middot-separated, right-aligned), 2.5px accent rule. */
    .header { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 2.5px solid var(--primary); padding-bottom: 6pt; margin-bottom: 10mm; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; line-height: 1.45; }
    .header-name { font-size: 17pt; font-weight: bold; color: #1a1a1a; white-space: nowrap; flex-shrink: 0; margin-right: 12pt; }
    .header-contact { text-align: right; font-size: 8pt; color: #555; line-height: 1.7; }
    .header-contact span { white-space: nowrap; }
    .recipient { margin-bottom: 6mm; font-size: 9.5pt; }
    .date { text-align: right; margin-bottom: 5mm; color: #666; font-size: 9pt; }
    .subject { font-weight: 700; font-size: 10.5pt; margin-bottom: 6mm; }
    .body p { margin-bottom: 4mm; font-size: 9.5pt; text-align: justify; }
    /* #547: break-inside:avoid pushes the WHOLE block to page 2 once it no
       longer fits the remainder of page 1, orphaning it alone with the
       freed space still visible on page 1 — 4mm less air shrinks the
       atomic unit so it fits the remainder more often (see academic_letter
       for the full rationale; same fix, N templates — ADR-066). */
    .signature { break-inside: avoid; page-break-inside: avoid; margin-top: 4mm; font-size: 9.5pt; }
    .signature .closing { margin-bottom: 6mm; }
    .signature-image { display: block; height: 14mm; width: auto; max-width: 60mm; margin: 0 0 1mm; }
    .signature.has-signature .closing { margin-bottom: 2mm; }
    /* #621 — the visual margin now lives in @page (Chromium's paged-media
       engine re-applies it on every page); .page's own padding/size, which
       used to BE the margin on the print path, is neutralised in print so it
       doesn't double up with @page. Kept for the on-screen HTML preview
       above (width/min-height/padding), which never goes through @page. */
    @page {
      size: A4;
      margin: 16mm 22mm 16mm 25mm;
    }
    @media print {
      body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .page { padding: 0; width: auto; min-height: auto; margin: 0; }
    }
  </style>
</head>
<body>
<div class="page">
  <div class="header">
    <div class="header-name">{{ letter.header.name }}</div>
    <div class="header-contact">{% if letter.header.address %}<span>{{ letter.header.address }}</span>{% endif %}{% if letter.header.email %} &nbsp;·&nbsp; <span>{{ letter.header.email }}</span>{% endif %}{% if letter.header.phone %} &nbsp;·&nbsp; <span>{{ letter.header.phone }}</span>{% endif %}</div>
  </div>
  <div class="recipient">{% if letter.recipient.name %}{{ letter.recipient.name }}<br>{% endif %}{% if letter.recipient.company %}{{ letter.recipient.company }}<br>{% endif %}{% if letter.recipient.address %}{{ letter.recipient.address }}{% endif %}</div>
  <div class="date">{{ letter.recipient.date }}</div>
  <div class="subject">{{ subject }}{% if letter.recipient.company %} — {{ letter.recipient.company }}{% endif %}</div>
  <div class="body">{% for para in letter.body.paragraphs %}<p>{{ para }}</p>{% endfor %}</div>
  <div class="signature{% if signature_image %} has-signature{% endif %}"><div class="closing">{{ letter.signature.closing }}{{ labels.closing_punctuation }}</div>{% if signature_image %}<img class="signature-image" src="{{ signature_image }}" alt="">{% endif %}<div>{{ letter.signature.name }}</div></div>
</div>
</body>
</html>
